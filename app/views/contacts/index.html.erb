<p style="color: green"><%= notice %></p>

<% content_for :title, t("contacts.index_title") %>

<h1><%= t("contacts.index_title") %></h1>

<div id="contacts">
  <% @contacts.each do |contact| %>
    <%= render contact %>
    <p>
      <%= link_to t("contacts.show_this"), contact %>
    </p>
  <% end %>
</div>

<%= link_to t("contacts.new"), new_contact_path %>
