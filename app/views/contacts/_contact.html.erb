    <strong><%= Contact.human_attribute_name(:firstname) %>:</strong>
    <%= contact.firstname %>
  </p>

  <p>
    <strong><%= Contact.human_attribute_name(:lastname) %>:</strong>
    <%= contact.lastname %>
  </p>

  <p>
    <strong><%= Contact.human_attribute_name(:address1) %>:</strong>
