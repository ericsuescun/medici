<%= form_with(model: campaign, url: form_url) do |f| %>
  <% if campaign.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= t("campaigns.errors_header", count: campaign.errors.count) %></h2>
      <ul>
        <% campaign.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="mb-4">
    <legend class="h5"><%= t("campaigns.form_content") %></legend>

    <div class="mb-3">
      <%= f.label :title, Campaign.human_attribute_name(:title), class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :description, Campaign.human_attribute_name(:description), class: "form-label" %>
      <%= f.text_area :description, rows: 4, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :call_to_action, Campaign.human_attribute_name(:call_to_action), class: "form-label" %>
      <%= f.text_field :call_to_action, class: "form-control" %>
      <div class="form-text"><%= t("campaigns.call_to_action_hint") %></div>
    </div>

    <div class="mb-3">
      <%= f.label :status, Campaign.human_attribute_name(:status), class: "form-label" %>
      <%= f.select :status, Campaign.statuses.keys.map { |s| [ t("enums.campaign.status.#{s}"), s ] }, {}, class: "form-select" %>
    </div>
  </fieldset>

  <fieldset class="mb-4">
    <legend class="h5"><%= t("campaigns.form_channels") %></legend>
    <div class="form-text mb-2"><%= t("campaigns.channels_hint") %></div>
    <div class="form-check">
      <%= f.check_box :target_instagram, class: "form-check-input" %>
      <%= f.label :target_instagram, Campaign.human_attribute_name(:target_instagram), class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= f.check_box :target_facebook, class: "form-check-input" %>
      <%= f.label :target_facebook, Campaign.human_attribute_name(:target_facebook), class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= f.check_box :target_twitter, class: "form-check-input" %>
      <%= f.label :target_twitter, Campaign.human_attribute_name(:target_twitter), class: "form-check-label" %>
    </div>
  </fieldset>

  <fieldset class="mb-4">
    <legend class="h5"><%= t("campaigns.form_credentials") %></legend>
    <div class="alert alert-info small">
      <%= t("campaigns.credentials_hint_html") %>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <h6>Instagram</h6>
        <%= f.label :instagram_user_id, Campaign.human_attribute_name(:instagram_user_id), class: "form-label" %>
        <%= f.text_field :instagram_user_id, class: "form-control mb-2" %>
        <%= f.label :instagram_access_token, Campaign.human_attribute_name(:instagram_access_token), class: "form-label" %>
        <%= f.password_field :instagram_access_token, value: "", autocomplete: "off",
              placeholder: t("campaigns.secret_placeholder"), class: "form-control" %>
      </div>

      <div class="col-md-4 mb-3">
        <h6>Facebook</h6>
        <%= f.label :facebook_page_id, Campaign.human_attribute_name(:facebook_page_id), class: "form-label" %>
        <%= f.text_field :facebook_page_id, class: "form-control mb-2" %>
        <%= f.label :facebook_page_access_token, Campaign.human_attribute_name(:facebook_page_access_token), class: "form-label" %>
        <%= f.password_field :facebook_page_access_token, value: "", autocomplete: "off",
              placeholder: t("campaigns.secret_placeholder"), class: "form-control" %>
      </div>

      <div class="col-md-4 mb-3">
        <h6>X (Twitter)</h6>
        <%= f.label :twitter_api_key, Campaign.human_attribute_name(:twitter_api_key), class: "form-label" %>
        <%= f.text_field :twitter_api_key, class: "form-control mb-2" %>
        <%= f.label :twitter_api_secret, Campaign.human_attribute_name(:twitter_api_secret), class: "form-label" %>
        <%= f.password_field :twitter_api_secret, value: "", autocomplete: "off",
              placeholder: t("campaigns.secret_placeholder"), class: "form-control mb-2" %>
        <%= f.label :twitter_access_token, Campaign.human_attribute_name(:twitter_access_token), class: "form-label" %>
        <%= f.password_field :twitter_access_token, value: "", autocomplete: "off",
              placeholder: t("campaigns.secret_placeholder"), class: "form-control mb-2" %>
        <%= f.label :twitter_access_token_secret, Campaign.human_attribute_name(:twitter_access_token_secret), class: "form-label" %>
        <%= f.password_field :twitter_access_token_secret, value: "", autocomplete: "off",
              placeholder: t("campaigns.secret_placeholder"), class: "form-control" %>
      </div>
    </div>
  </fieldset>

  <div class="mt-3">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
  </div>
<% end %>
