<%= form_with model: [@patient, soap_note] do |f| %>
  <% if soap_note.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% soap_note.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :encounter_date, t("soap_notes.encounter_date"), class: "form-label" %>
    <%= f.date_field :encounter_date, class: "form-control", style: "max-width: 16rem" %>
  </div>

  <% SoapNote::SECTIONS.each do |section| %>
    <div class="card mb-3">
      <div class="card-header">
        <strong><%= t("soap_notes.sections.#{section}.label") %></strong>
        <span class="text-muted small ms-2"><%= t("soap_notes.sections.#{section}.hint") %></span>
      </div>
      <div class="card-body">
        <%= f.rich_text_area section %>
      </div>
    </div>
  <% end %>

  <p class="text-muted small">
    <i class="bi bi-cloud-arrow-up"></i> <%= t("soap_notes.attachment_hint") %>
  </p>

  <div class="d-flex gap-2">
    <%= f.submit t("soap_notes.save"), class: "btn btn-success" %>
    <%= link_to t("common.cancel"), patient_soap_notes_path(@patient), class: "btn btn-link" %>
  </div>
<% end %>
