<div class="container mt-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="mb-0"><%= t("soap_notes.index_title") %></h1>
      <p class="text-muted mb-0"><%= @patient.fullname.presence || @patient.participant_code %></p>
    </div>
    <% if policy(@patient).update? %>
      <%= link_to t("soap_notes.new_note"), new_patient_soap_note_path(@patient), class: "btn btn-primary" %>
    <% end %>
  </div>

  <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>

  <% if @soap_notes.none? %>
    <p class="text-muted"><%= t("soap_notes.none") %></p>
  <% else %>
    <div class="d-flex flex-column gap-3">
      <% @soap_notes.each do |note| %>
        <div class="health-card card">
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
              <h5 class="card-title mb-0">
                <%= link_to l(note.encounter_date, format: :long), patient_soap_note_path(@patient, note), class: "text-decoration-none" %>
              </h5>
              <span class="text-muted small">
                <%= note.author&.fullname || t("soap_notes.unknown_author") %>
              </span>
            </div>
            <div class="row g-2 mb-2">
              <% SoapNote::SECTIONS.each do |section| %>
                <div class="col-6 col-md-3">
                  <span class="badge <%= note.section_present?(section) ? "bg-success" : "bg-light text-muted border" %>">
                    <%= t("soap_notes.sections.#{section}.short") %>
                  </span>
                </div>
              <% end %>
            </div>
            <% preview_section = SoapNote::SECTIONS.find { |s| note.section_present?(s) } %>
            <% if preview_section %>
              <p class="text-muted small mb-0"><%= truncate(note.public_send(preview_section).to_plain_text, length: 180) %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to t("soap_notes.back_to_patient"), patient_path(@patient), class: "btn btn-link" %>
  </div>
</div>
