<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>

      <% content_for :title, "Users" %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Gestión de Usuarios</h1>
        <div>
          <%= link_to "Retornar a Medici", static_pages_medici_home_path, class: "btn btn-outline-primary me-2" %>
          <%= link_to "Nuevo usuario", new_user_path, class: "btn btn-success" %>
        </div>
      </div>

      <div class="row" id="users">
        <div class="col-md-6 mb-4">
          <div class="card health-card shadow-sm">
            <h5 class="card-header">Usuarios Administradores</h5>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped mb-0">
                  <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Telefono</th>
                    <th>Direccion</th>
                    <th>Email</th>
                  </tr>
                  </thead>
                  <tbody>
                  <% @admins.each do |user| %>
                    <tr>
                      <td><%= link_to user.fullname, user %></td>
                      <td><%= user.contact_number %></td>
                      <td><%= user.contact_address %></td>
                      <td><%= user.email %></td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 mb-4">
          <div class="card health-card shadow-sm">
            <h5 class="card-header">Usuarios Patrocinadores</h5>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped mb-0">
                  <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Telefono</th>
                    <th>Direccion</th>
                    <th>Email</th>
                  </tr>
                  </thead>
                  <tbody>
                  <% @sponsors.each do |user| %>
                    <tr>
                      <td><%= link_to user.fullname, user %></td>
                      <td><%= user.contact_number %></td>
                      <td><%= user.contact_address %></td>
                      <td><%= user.email %></td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-8 mb-4">
          <div class="card health-card shadow-sm">
            <h5 class="card-header">Usuarios Pacientes</h5>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-striped mb-0">
                  <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Telefono</th>
                    <th>Direccion</th>
                    <th>Email</th>
                    <th>Estudios</th>
                  </tr>
                  </thead>
                  <tbody>
                  <% @patients.each do |user| %>
                    <tr>
                      <td><%= link_to user.fullname, user %></td>
                      <td><%= user.contact_number %></td>
                      <td><%= user.contact_address %></td>
                      <td><%= user.email %></td>
                      <td><span class="badge bg-primary"><%= user.studies.count %></span></td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="d-flex justify-content-between align-items-center mt-4">
        <%= will_paginate @users, :renderer => WillPaginate::ActionView::Bootstrap4LinkRenderer %>
        <div>
          <%= link_to "Retornar a Be My Trial", static_pages_medici_home_path, class: "btn btn-outline-primary me-2" %>
          <%= link_to "Nuevo usuario", new_user_path, class: "btn btn-success" %>
        </div>
      </div>
    </div>
  </div>
</div>
