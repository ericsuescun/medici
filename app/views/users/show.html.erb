<div class="container-fluid">
  <div class="row">
    <div class="col-4 mx-auto">
      <p style="color: green"><%= notice %></p>

      <%= render @user %>

      <div>
        <%= link_to "Editar este usuario", edit_user_path(@user) %> |
        <%= link_to "Retornar a usuarios", users_path unless current_user&.patient? %>
        <%= link_to "Retornar a Vitalia", static_pages_medici_home_path %>

        <%= button_to "Borrar", @user, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>
    </div>
  </div>
</div>
