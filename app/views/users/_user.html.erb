<div class="card user-card">
  <h5 class="card-header"><%= user.fullname %></h5>
  <div class="card-body">

    <p class="card-text">
      <strong>Email:</strong>
      <%= user.email %>
    </p>


    <p class="card-text">
      <strong>Descripcion de la enfermedad:</strong>
      <%= user.illness_description %>
    </p>


    <h6><strong>Estudio asociado</strong></h6>
    <%= render(partial: 'studies/brief_study_index', locals: { studies: @studies }) if user.patient? && @studies.present? %>
  </div>
</div>