<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @sponsor_rep.fullname %></h3>
  </div>
  <div class="card-body">
    <p><strong><%= t("sponsor_reps.email") %>:</strong> <%= @sponsor_rep.email %></p>
    <p><strong><%= SponsorRep.human_attribute_name(:contact_number) %>:</strong> <%= @sponsor_rep.contact_number %></p>
    <p><strong><%= SponsorRep.human_attribute_name(:contact_address) %>:</strong> <%= @sponsor_rep.contact_address %></p>
    <p><strong><%= SponsorRep.human_attribute_name(:title) %>:</strong> <%= @sponsor_rep.title %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to t("sponsor_reps.show_edit"), edit_sponsor_rep_path(@sponsor_rep) %> |
  <%= link_to t("sponsor_reps.show_back"), sponsor_reps_path %>
  <%= button_to t("sponsor_reps.show_destroy"), @sponsor_rep, method: :delete, class: "btn btn-danger ms-2" %>
</div>
