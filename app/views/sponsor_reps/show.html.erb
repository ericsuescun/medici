<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @sponsor_rep.fullname %></h3>
  </div>
  <div class="card-body">
    <p><strong>Email:</strong> <%= @sponsor_rep.email %></p>
    <p><strong>Telefono:</strong> <%= @sponsor_rep.contact_number %></p>
    <p><strong>Direccion:</strong> <%= @sponsor_rep.contact_address %></p>
    <p><strong>Titulo:</strong> <%= @sponsor_rep.title %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to "Edit this representative", edit_sponsor_rep_path(@sponsor_rep) %> |
  <%= link_to "Back to representatives", sponsor_reps_path %>
  <%= button_to "Destroy this representative", @sponsor_rep, method: :delete, class: "btn btn-danger ms-2" %>
</div>
