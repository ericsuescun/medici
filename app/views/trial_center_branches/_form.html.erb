<%= form_with(model: trial_center_branch) do |form| %>
  <% if trial_center_branch.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(trial_center_branch.errors.count, "error") %> prohibited this trial_center_branch from being saved:</h2>

      <ul>
        <% trial_center_branch.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<%= form.hidden_field :trial_center_facility_id, value: params[:trial_center_facility_id] if params[:trial_center_facility_id].present? %>
  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :initials, style: "display: block" %>
    <%= form.text_field :initials, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description, class: "form-control mb-3" %>
  </div>

  <div class="form-group">
    <%= form.label "Ciudad" %>
    <%= form.select(:city_id, options_for_select(City.all.pluck(:name, :id), trial_center_branch&.cities&.first&.id), { include_blank: true }, class: "form-select mb-3") %>
  </div>

  <div>
    <%= form.label :url, style: "display: block" %>
    <%= form.text_field :url, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.submit 'Guardar', class: 'btn btn-primary btn-block' %>
  </div>
<% end %>
