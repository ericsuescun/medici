<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% content_for :title, "Trial center branches" %>

  <h1 class="mb-4">Trial center branches</h1>

  <div id="trial_center_branches" class="row">
    <% @trial_center_branches.each do |trial_center_branch| %>
      <div class="col-md-6 mb-4">
        <%= render trial_center_branch %>
        <div class="mt-2">
          <%= link_to "Show this trial center branch", trial_center_branch, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to "New trial center branch", new_trial_center_branch_path, class: "btn btn-success" %>
  </div>
</div>
