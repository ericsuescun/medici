<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% content_for :title, "Trial center branches" %>

  <h1 class="mb-4">Sedes</h1>

  <div class="mb-4">
    <%= link_to "Retornar a Be My Trial", static_pages_medici_home_path %> |
    <%= link_to "Nueva Sede", new_trial_center_branch_path %>
  </div>

  <div id="trial_center_branches" class="row">
    <% @trial_center_branches.each do |trial_center_branch| %>
      <div class="col-md-6 mb-4">
        <%= render trial_center_branch %>
        <div class="mt-2">
          <%= link_to "Mostrar", trial_center_branch, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to "Retornar a Be My Trial", static_pages_medici_home_path %> |
    <%= link_to "Nueva sede", new_trial_center_branch_path %>
  </div>
</div>
