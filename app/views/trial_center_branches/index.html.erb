<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% content_for :title, t("trial_center_branches.index_title") %>

  <h1 class="mb-4"><%= t("trial_center_branches.index_title") %></h1>

  <div class="mb-4">
    <%= link_to t("trial_center_branches.back_home"), static_pages_medici_home_path %> |
    <%= link_to t("trial_center_branches.new_title"), new_trial_center_branch_path %>
  </div>

  <div id="trial_center_branches" class="row">
    <% @trial_center_branches.each do |trial_center_branch| %>
      <div class="col-md-6 mb-4">
        <%= render trial_center_branch %>
        <div class="mt-2">
          <%= link_to t("common.show"), trial_center_branch, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to t("trial_center_branches.back_home"), static_pages_medici_home_path %> |
    <%= link_to t("trial_center_branches.new_title"), new_trial_center_branch_path %>
  </div>
</div>
