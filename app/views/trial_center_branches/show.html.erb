<div class="container">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <%= render @trial_center_branch %>

      <div>
        <%= link_to "Editar esta sede", edit_trial_center_branch_path(@trial_center_branch) %> |
        <%= link_to "Retornar a #{@trial_center_branch.trial_center_facility.name}", trial_center_facility_path(@trial_center_branch.trial_center_facility)  %>

        <%= button_to "Borrar", @trial_center_branch, method: :delete, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <hr/>
      <div class="mt-3">
        <h4>Representantes de Sede</h4>
        <% reps = @trial_center_branch.trial_center_branch_reps.includes(:user) %>
        <% if reps.any? %>
          <div class="table-responsive">
            <table class="table table-striped align-middle">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Email</th>
                  <th>Título</th>
                  <th>Teléfono</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% reps.each do |r| %>
                  <tr>
                    <td>
                      <%= link_to (r.fullname.presence || r.email), trial_center_branch_rep_path(r) %>
                    </td>
                    <td><%= r.email %></td>
                    <td><%= r.title %></td>
                    <td><%= r.contact_number %></td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-2">
                        <% if policy(r).edit? %>
                          <%= link_to 'Editar', edit_trial_center_branch_rep_path(r), class: 'btn btn-sm btn-outline-secondary' %>
                        <% end %>
                        <% if policy(@trial_center_branch).update? %>
                          <%= button_to 'Desasociar', remove_rep_trial_center_branch_path(@trial_center_branch, rep_id: r.id), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: '¿Desasociar este representante de la sede?' } } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted">No hay representantes asociados.</p>
        <% end %>

        <% available_users = User.trial_center_branch_reps.includes(:userable).select { |u| u.userable&.trial_center_branch_id.nil? } %>
        <% if available_users.any? %>
          <%= form_with url: add_rep_trial_center_branch_path(@trial_center_branch), method: :post, class: 'row g-2 align-items-end' do |f| %>
            <div class="col-md-6">
              <label for="rep_id" class="form-label">Asociar representante desde usuarios</label>
              <%= select_tag :rep_id, options_for_select(available_users.map { |u| [(u.fullname.presence || u.email), u.userable_id] }), include_blank: 'Seleccione un representante', class: 'form-select' %>
            </div>
            <div class="col-md-3">
              <button type="submit" class="btn btn-primary">Asociar</button>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted">No hay representantes disponibles para asociar.</p>
        <% end %>

      </div>
    </div>
  </div>
</div>
