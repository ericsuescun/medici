<div class="container">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <%= render @trial_center_branch %>

      <div>
        <%= link_to "Editar esta sede", edit_trial_center_branch_path(@trial_center_branch) %> |
        <%= link_to "Retornar a #{@trial_center_branch.trial_center_facility.name}", trial_center_facility_path(@trial_center_branch.trial_center_facility)  %>

        <%= button_to "Borrar", @trial_center_branch, method: :delete, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <hr/>
      <div class="mt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h4 class="mb-0">Representantes de Sede</h4>
          <% if policy(TrialCenterBranchRep).new? %>
            <%= link_to "Nuevo representante", new_trial_center_branch_rep_path(trial_center_branch_id: @trial_center_branch.id), class: "btn btn-sm btn-primary" %>
          <% end %>
        </div>
        <% reps = @trial_center_branch.trial_center_branch_reps.includes(:user) %>
        <% if reps.any? %>
          <div class="table-responsive">
            <table class="table table-striped align-middle">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Email</th>
                  <th>Título</th>
                  <th>Teléfono</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% reps.each do |r| %>
                  <tr>
                    <td>
                      <%= link_to (r.fullname.presence || r.email), trial_center_branch_rep_path(r) %>
                    </td>
                    <td><%= r.email %></td>
                    <td><%= r.title %></td>
                    <td><%= r.contact_number %></td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-2">
                        <% if policy(r).edit? %>
                          <%= link_to 'Editar', edit_trial_center_branch_rep_path(r), class: 'btn btn-sm btn-outline-secondary' %>
                        <% end %>
                        <% if policy(r).destroy? %>
                          <%= button_to 'Eliminar', trial_center_branch_rep_path(r), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: '¿Eliminar este representante?' } } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted">No hay representantes en esta sede.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
