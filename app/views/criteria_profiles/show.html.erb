<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <%= render @criteria_profile %>

      <div class="mt-3">
        <%= link_to "Editar", edit_criteria_profile_path(@criteria_profile) %> |
        <%= link_to "Retornar a Perfiles", criteria_profiles_path %>

        <%= button_to "Borrar", @criteria_profile, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <hr/>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>Variables de Criterios</h3>
        <%= link_to 'Nueva Variable', new_criteria_profile_criteria_variable_path(@criteria_profile), class: 'btn btn-primary' %>
      </div>

      <% if @criteria_profile.criteria_variables.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Tipo de regla</th>
            <th>Comparación</th>
            <th>Ref 1</th>
            <th>Ref 2</th>
            <th>Escala cualitativa</th>
            <th>Valor cualitativo</th>
            <th></th>
          </tr>
          </thead>
          <tbody>
          <% @criteria_profile.criteria_variables.order(created_at: :desc).each do |variable| %>
            <tr>
              <td><%= link_to variable.name, [@criteria_profile, variable] %></td>
              <td><%= variable.value_type %></td>
              <td>
                <% if variable.variable_type == "inclusion" %>
                  <span class="badge bg-success">inclusion</span>
                <% else %>
                  <span class="badge bg-danger">exclusion</span>
                <% end %>
              </td>
              <td><%= variable.comparison_type %></td>
              <td><%= variable.reference_value_1 %></td>
              <td><%= variable.reference_value_2 %></td>
              <td><%= (variable.qualitative_scale || []).join(', ') %></td>
              <td><%= variable.qualitative_value %></td>
              <td>
                <%= link_to 'Editar', edit_criteria_profile_criteria_variable_path(@criteria_profile, variable) %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
        <%= link_to 'Ver todas las variables', criteria_profile_criteria_variables_path(@criteria_profile) %>
      <% else %>
        <div class="alert alert-info">Este perfil no tiene variables aún.</div>
      <% end %>
    </div>
  </div>
</div>
