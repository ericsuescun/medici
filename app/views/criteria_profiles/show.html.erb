<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <%= render @criteria_profile %>

      <div class="mt-3">
        <%= link_to t("common.edit"), edit_criteria_profile_path(@criteria_profile) %> |
        <%= link_to t("criteria_profiles.back_to_profiles"), criteria_profiles_path %>
        <% if current_user&.admin? %>
          | <%= link_to t("criteria_profiles.change_control"), change_control_path("CriteriaProfile", @criteria_profile.id) %>
        <% end %>

        <%= button_to t("common.delete"), @criteria_profile, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <hr/>
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h3><%= t("criteria_profiles.variables_section") %></h3>
        <%= link_to t("criteria_variables.new_variable"), new_criteria_profile_criteria_variable_path(@criteria_profile), class: 'btn btn-primary' %>
      </div>

      <% if @criteria_profile.criteria_variables.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th><%= CriteriaVariable.human_attribute_name(:criteria_order) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:name) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:value_type) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:variable_type) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:criteria_category) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:patient_prompt) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:comparison_type) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:reference_value_1) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:reference_value_2) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:qualitative_scale) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:qualitative_value) %></th>
            <th></th>
          </tr>
          </thead>
          <tbody>
          <% @criteria_profile.criteria_variables.order(Arel.sql("CASE WHEN variable_type = 'inclusion' THEN 0 ELSE 1 END, COALESCE(criteria_order, 2147483647) ASC"), :name).each do |variable| %>
            <tr>
              <td><%= variable.criteria_order.present? ? variable.criteria_order : '-' %></td>
              <td><%= link_to variable.name, [@criteria_profile, variable] %></td>
              <td><%= t_enum(variable, :value_type) %></td>
              <td><%= variable_type_badge(variable) %></td>
              <td><%= criteria_category_badge(variable) %></td>
              <td style="min-width: 14rem"><%= patient_prompt_display(variable) %></td>
              <td><%= t_enum(variable, :comparison_type) %></td>
              <td><%= variable.reference_value_1 %></td>
              <td><%= variable.reference_value_2 %></td>
              <td><%= (variable.qualitative_scale || []).join(', ') %></td>
              <td><%= variable.qualitative_value %></td>
              <td>
                <%= link_to 'Editar', edit_criteria_profile_criteria_variable_path(@criteria_profile, variable) %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
        <%= link_to t("criteria_profiles.view_all_variables"), criteria_profile_criteria_variables_path(@criteria_profile) %>
      <% else %>
        <div class="alert alert-info"><%= t("criteria_profiles.no_variables") %></div>
      <% end %>
    </div>
  </div>
</div>
