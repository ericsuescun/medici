<div id="<%= dom_id criteria_profile %>" class="card">
  <div class="card-header">
    <h3 class="card-title"><%= criteria_profile.name %></h3>
  </div>
  <div class="card-body">
    <p>
      <strong><%= CriteriaProfile.human_attribute_name(:description) %>:</strong>
      <%= criteria_profile.description.presence || '-' %>
    </p>
    <p>
      <strong><%= Study.model_name.human %>:</strong>
      <% if criteria_profile.study.present? %>
        <%= link_to criteria_profile.study.short_title, criteria_profile.study %>
      <% else %>
        <span class="text-muted"><%= t("criteria_profiles.not_associated") %></span>
      <% end %>
    </p>
    <p>
      <strong><%= User.model_name.human %>:</strong>
      <%= criteria_profile.user.fullname.presence || criteria_profile.user.email %>
    </p>
  </div>
</div>
