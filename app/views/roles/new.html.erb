<div class="container mt-4">
  <h1 class="mb-3"><%= t("roles.new_title") %></h1>

  <%= form_with model: @role, url: roles_path, method: :post do |form| %>
    <% if @role.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @role.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name, t("roles.internal_name"), class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: t("roles.name_placeholder") %>
      <div class="form-text"><%= t("roles.name_hint") %></div>
    </div>

    <div class="mb-3">
      <%= form.label :display_name, t("roles.display_name"), class: "form-label" %>
      <%= form.text_field :display_name, class: "form-control", placeholder: t("roles.display_name_placeholder") %>
    </div>

    <div class="mb-3">
      <%= form.label :description, t("roles.description"), class: "form-label" %>
      <%= form.text_area :description, class: "form-control", rows: 3 %>
    </div>

    <div class="mb-3">
      <%= label_tag :clone_from_role_id, t("roles.clone_from"), class: "form-label" %>
      <%= select_tag :clone_from_role_id,
                     options_from_collection_for_select(@roles, :id, :display_name),
                     include_blank: t("roles.clone_none"),
                     class: "form-select" %>
      <div class="form-text"><%= t("roles.clone_hint") %></div>
    </div>

    <%= form.submit t("roles.create_role"), class: "btn btn-success" %>
    <%= link_to t("common.cancel"), roles_path, class: "btn btn-link" %>
  <% end %>
</div>
