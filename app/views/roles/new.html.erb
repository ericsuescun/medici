<div class="container mt-4">
  <h1 class="mb-3">Nuevo Rol</h1>

  <%= form_with model: @role, url: roles_path, method: :post do |form| %>
    <% if @role.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @role.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :name, "Nombre interno", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: "p. ej. auditor" %>
      <div class="form-text">Identificador en minúsculas, sin espacios. Único.</div>
    </div>

    <div class="mb-3">
      <%= form.label :display_name, "Nombre visible", class: "form-label" %>
      <%= form.text_field :display_name, class: "form-control", placeholder: "p. ej. Auditor" %>
    </div>

    <div class="mb-3">
      <%= form.label :description, "Descripción", class: "form-label" %>
      <%= form.text_area :description, class: "form-control", rows: 3 %>
    </div>

    <div class="mb-3">
      <%= label_tag :clone_from_role_id, "Clonar permisos de (opcional)", class: "form-label" %>
      <%= select_tag :clone_from_role_id,
                     options_from_collection_for_select(@roles, :id, :display_name),
                     include_blank: "— Ninguno (empezar sin permisos) —",
                     class: "form-select" %>
      <div class="form-text">Si eliges un rol, el nuevo rol copiará sus permisos actuales.</div>
    </div>

    <%= form.submit "Crear rol", class: "btn btn-success" %>
    <%= link_to "Cancelar", roles_path, class: "btn btn-link" %>
  <% end %>
</div>
