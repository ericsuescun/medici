<div class="container mt-4">
  <h1 class="mb-2"><%= t("roles.permissions_for", role: @role.display_name) %></h1>
  <p class="text-muted"><%= t("roles.edit_help") %></p>

  <%= form_with model: @role, url: role_path(@role), method: :patch do |form| %>
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th><%= t("roles.resource") %></th>
          <th class="text-center"><%= t("common.show") %></th>
          <th class="text-center"><%= t("common.edit") %></th>
          <th class="text-center"><%= t("common.destroy") %></th>
        </tr>
      </thead>
      <tbody>
        <%= form.fields_for :role_permissions, @role.role_permissions.sort_by(&:resource) do |perm| %>
          <tr>
            <td>
              <%= perm.hidden_field :resource %>
              <%= perm.object.resource %>
            </td>
            <td class="text-center"><%= perm.check_box :can_show %></td>
            <td class="text-center"><%= perm.check_box :can_edit %></td>
            <td class="text-center"><%= perm.check_box :can_delete %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= form.submit t("roles.save_permissions"), class: "btn btn-success" %>
    <%= link_to t("common.cancel"), roles_path, class: "btn btn-link" %>
  <% end %>
</div>
