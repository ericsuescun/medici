<div class="container mt-4">
  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><%= t("roles.index_title") %></h1>
    <%= link_to t("roles.new"), new_role_path, class: "btn btn-primary" %>
  </div>

  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th><%= t("roles.role") %></th>
        <th><%= t("roles.internal_name") %></th>
        <th><%= t("roles.resources_with_permissions") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @roles.each do |role| %>
        <tr>
          <td><%= role.display_name %></td>
          <td><code><%= role.name %></code></td>
          <td><%= role.role_permissions.count %></td>
          <td class="text-end">
            <%= link_to t("roles.edit_permissions"), edit_role_path(role), class: "btn btn-sm btn-primary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to t("roles.back_to_home"), root_path, class: "btn btn-link" %>
</div>
