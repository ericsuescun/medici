<div id="<%= dom_id article %>">
  <p>
    <strong><%= Article.human_attribute_name(:title) %>:</strong>
    <%= article.title %>
  </p>

  <p>
    <strong><%= Article.human_attribute_name(:description) %>:</strong>
    <%= article.description %>
  </p>

  <p>
    <strong><%= Article.human_attribute_name(:url) %>:</strong>
    <%= article.url %>
  </p>

  <p>
    <strong><%= Article.human_attribute_name(:studies_id) %>:</strong>
    <%= article.studies_id %>
  </p>

</div>
