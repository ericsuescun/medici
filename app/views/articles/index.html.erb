<p style="color: green"><%= notice %></p>

<% content_for :title, t("articles.index_title") %>

<h1><%= t("articles.index_title") %></h1>

<div id="articles">
  <% @articles.each do |article| %>
    <%= render article %>
    <p>
      <%= link_to t("articles.show_this"), article %>
    </p>
  <% end %>
</div>

<%= link_to t("articles.new"), new_article_path %>
