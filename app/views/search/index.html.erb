<div class="container my-4">
  <h1 class="h3 mb-3"><%= t("search.title") %></h1>

  <%= form_with url: search_path, method: :get, class: "d-flex mb-4", role: "search" do |f| %>
    <%= f.search_field :q, value: @query, class: "form-control me-2", placeholder: t("nav.search"), aria: { label: t("nav.search") } %>
    <%= f.submit t("nav.search"), class: "btn btn-primary" %>
  <% end %>

  <% if @query.blank? %>
    <p class="text-muted"><%= t("search.prompt") %></p>
  <% elsif @groups.empty? %>
    <p class="text-muted"><%= t("search.no_results", query: @query) %></p>
  <% else %>
    <p class="text-muted small"><%= t("search.results_for", query: @query) %></p>

    <% @groups.each do |group| %>
      <div class="card health-card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= t("search.types.#{group.type}") %></strong>
          <span class="badge bg-secondary"><%= group.records.size %></span>
        </div>
        <ul class="list-group list-group-flush">
          <% case group.type %>
          <% when :studies %>
            <% group.records.each do |study| %>
              <li class="list-group-item">
                <%= link_to study.display_title, study, class: "text-decoration-none fw-semibold" %>
                <% if study.short_title.present? && study.short_title != study.public_title %>
                  <span class="text-muted small">· <%= study.short_title %></span>
                <% end %>
              </li>
            <% end %>

          <% when :categories %>
            <% group.records.each do |result| %>
              <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <%# Links to the public home-page filter for that category. %>
                <%= link_to result.category.name, root_path(category: result.category.id, anchor: "estudios"), class: "text-decoration-none fw-semibold" %>
                <span class="badge bg-primary rounded-pill"><%= t("search.studies_count", count: result.studies_count) %></span>
              </li>
            <% end %>

          <% when :trial_centers %>
            <% group.records.each do |center| %>
              <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <%= link_to center.name.presence || center.description.presence || "##{center.id}", center, class: "text-decoration-none fw-semibold" %>
                <span class="badge bg-light text-dark border"><%= center.model_name.human %></span>
              </li>
            <% end %>

          <% when :reps %>
            <% group.records.each do |rep| %>
              <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                <span>
                  <%= link_to rep.fullname.presence || t("search.unnamed"), rep, class: "text-decoration-none fw-semibold" %>
                  <% if rep.email.present? %><span class="text-muted small">· <%= rep.email %></span><% end %>
                </span>
                <span class="badge bg-light text-dark border"><%= rep.model_name.human %></span>
              </li>
            <% end %>

          <% when :patients %>
            <% group.records.each do |patient| %>
              <li class="list-group-item">
                <%= link_to patient.display_name, patient, class: "text-decoration-none fw-semibold" %>
                <span class="text-muted small">· <%= patient.participant_code %></span>
              </li>
            <% end %>

          <% when :cities %>
            <% group.records.each do |result| %>
              <li class="list-group-item">
                <div class="fw-semibold"><i class="bi bi-geo-alt"></i> <%= result.city.name %></div>
                <% if result.studies.any? %>
                  <div class="mt-1 d-flex flex-wrap gap-2">
                    <% result.studies.each do |study| %>
                      <%= link_to study.display_title, study, class: "badge bg-info text-dark text-decoration-none" %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-muted small"><%= t("search.no_studies_in_city") %></span>
                <% end %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
