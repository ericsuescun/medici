<div class="container mt-4">
  <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
  <% if alert %><div class="alert alert-danger"><%= alert %></div><% end %>

  <%# ---- Header ---- %>
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-1">
    <div>
      <h1 class="mb-0"><%= t("patient_briefings.title") %></h1>
      <p class="text-muted mb-0">
        <strong><%= @patient.fullname.presence || @patient.participant_code %></strong>
        <% if @patient.study %> · <%= @patient.study.public_title %><% end %>
        <span class="text-muted">· <%= @patient.participant_code %></span>
      </p>
    </div>
    <span class="badge rounded-pill bg-light text-dark border align-self-center fs-6">
      <%= Patient.human_attribute_name(:state) %>: <strong><%= t("patients.states.#{@patient.state}", default: @patient.state) %></strong>
    </span>
  </div>

  <%# ---- Take action: promote through the lifecycle ---- %>
  <% eligible = @result&.eligible? %>
  <% forward_event = { "interested" => "assess", "candidate" => "accept" }[@patient.state] %>
  <% any_transition = %w[assess accept discard reject].any? { |e| policy(@patient).public_send("#{e}?") } %>
  <% if any_transition %>
    <div class="card my-3">
      <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h5 class="card-title mb-1"><%= t("criteria_assessments.brief.take_action") %></h5>
          <p class="text-muted small mb-0">
            <% if forward_event && eligible %>
              <%= t("criteria_assessments.brief.promote_hint_eligible", event: t("patients.#{forward_event}")) %>
            <% elsif @result && !@result.complete? %>
              <%= t("criteria_assessments.brief.promote_hint_incomplete") %>
            <% elsif @result && !eligible %>
              <%= t("criteria_assessments.brief.promote_hint_not_eligible") %>
            <% else %>
              <%= t("criteria_assessments.brief.promote_hint_generic") %>
            <% end %>
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% if policy(@patient).assess? %>
            <%= button_to t("patients.assess"), transition_patient_path(@patient, event: "assess"), method: :post,
                          class: "btn btn-sm #{forward_event == 'assess' && eligible ? 'btn-success' : 'btn-outline-primary'}" %>
          <% end %>
          <% if policy(@patient).accept? %>
            <%= button_to t("patients.accept"), transition_patient_path(@patient, event: "accept"), method: :post,
                          class: "btn btn-sm #{forward_event == 'accept' && eligible ? 'btn-success' : 'btn-outline-success'}" %>
          <% end %>
          <% if policy(@patient).discard? %>
            <%= button_to t("patients.discard"), transition_patient_path(@patient, event: "discard"), method: :post, class: "btn btn-sm btn-outline-warning" %>
          <% end %>
          <% if policy(@patient).reject? %>
            <%= button_to t("patients.reject"), transition_patient_path(@patient, event: "reject"), method: :post, class: "btn btn-sm btn-outline-danger" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row g-3">
    <%# ---- Eligibility snapshot ---- %>
    <div class="col-lg-7">
      <div class="health-card card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= t("patient_briefings.eligibility") %></strong>
          <% if @profile %>
            <%= link_to t("patient_briefings.open_assessment"), patient_criteria_assessment_path(@patient, criteria_profile_id: @profile.id), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
        </div>
        <div class="card-body">
          <% if @result.nil? %>
            <p class="text-muted mb-0"><%= t("patient_briefings.no_profile") %></p>
          <% else %>
            <% case @result.verdict %>
            <% when :eligible %>
              <div class="alert alert-success py-2"><strong><%= t("criteria_assessments.eligible") %></strong> — <%= t("criteria_assessments.eligible_detail") %></div>
            <% when :not_eligible %>
              <div class="alert alert-danger py-2"><strong><%= t("criteria_assessments.not_eligible") %></strong> — <%= t("criteria_assessments.not_eligible_detail", count: @result.failing.count) %></div>
            <% when :incomplete %>
              <div class="alert alert-warning py-2"><strong><%= t("criteria_assessments.incomplete") %></strong> — <%= t("criteria_assessments.incomplete_detail", count: @result.missing.count) %></div>
            <% else %>
              <div class="alert alert-secondary py-2"><%= t("criteria_assessments.no_criteria") %></div>
            <% end %>

            <div class="row g-2 mb-3">
              <div class="col-3"><div class="stat-card text-center p-2 border rounded"><div class="fw-bold text-success"><%= @result.passing.count %></div><div class="text-muted small"><%= t("criteria_assessments.brief.passing") %></div></div></div>
              <div class="col-3"><div class="stat-card text-center p-2 border rounded"><div class="fw-bold text-danger"><%= @result.failing.count %></div><div class="text-muted small"><%= t("criteria_assessments.brief.out_of_reach") %></div></div></div>
              <div class="col-3"><div class="stat-card text-center p-2 border rounded"><div class="fw-bold text-secondary"><%= @result.pending.count %></div><div class="text-muted small"><%= t("criteria_assessments.brief.pending") %></div></div></div>
              <div class="col-3"><div class="stat-card text-center p-2 border rounded"><div class="fw-bold"><%= @result.answered_count %>/<%= @result.total_count %></div><div class="text-muted small"><%= t("criteria_assessments.brief.answered") %></div></div></div>
            </div>

            <% if @result.failing.any? %>
              <div class="mb-2">
                <div class="fw-semibold text-danger small mb-1"><%= t("criteria_assessments.brief.out_of_reach_heading", count: @result.failing.count) %></div>
                <ul class="small mb-0">
                  <% @result.failing.each do |c| %>
                    <li><%= c.variable.name %> — <%= t("criteria_assessments.brief.required") %>: <%= c.variable.rule_summary %>, <%= t("criteria_assessments.brief.measured") %>: <span class="text-danger"><%= c.value %></span></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <% if @result.pending.any? %>
              <div>
                <div class="fw-semibold text-secondary small mb-1"><%= t("criteria_assessments.brief.pending_heading", count: @result.pending.count) %></div>
                <ul class="small mb-0">
                  <% @result.pending.each do |c| %>
                    <li><%= c.variable.name %> — <%= t("criteria_assessments.brief.required") %>: <%= c.variable.rule_summary %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <%# ---- SOAP notes ---- %>
      <div class="health-card card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= t("soap_notes.index_title") %> <span class="badge bg-secondary"><%= @notes_count %></span></strong>
          <%= link_to t("patient_briefings.open_notes"), patient_soap_notes_path(@patient), class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <div class="card-body">
          <% if @recent_notes.empty? %>
            <p class="text-muted mb-0"><%= t("soap_notes.none") %></p>
          <% else %>
            <ul class="list-group list-group-flush">
              <% @recent_notes.each do |note| %>
                <li class="list-group-item px-0">
                  <%= link_to l(note.encounter_date, format: :long), patient_soap_note_path(@patient, note), class: "text-decoration-none" %>
                  <span class="text-muted small">· <%= note.author&.fullname || t("soap_notes.unknown_author") %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>

      <%# ---- Complementary information ---- %>
      <div class="health-card card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= t("complementary_informations.index_title") %></strong>
          <%= link_to t("patient_briefings.open_information"), patient_complementary_information_path(@patient), class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <div class="card-body">
          <% if @complementary_information&.any_content? %>
            <ul class="list-unstyled mb-0 small">
              <li><i class="bi bi-file-earmark-pdf"></i> <%= t("complementary_informations.documents") %>: <strong><%= @complementary_information.documents.count %></strong></li>
              <li><i class="bi bi-image"></i> <%= t("complementary_informations.images") %>: <strong><%= @complementary_information.images.count %></strong></li>
              <li><i class="bi bi-journal-text"></i> <%= t("complementary_informations.notes") %>: <strong><%= @complementary_information.notes.present? ? t("common.yes") : t("common.no") %></strong></li>
            </ul>
          <% else %>
            <p class="text-muted mb-0"><%= t("complementary_informations.empty") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to t("soap_notes.back_to_patient"), patient_path(@patient), class: "btn btn-link" %>
  </div>
</div>
