<%= form_with(model: platform_staff) do |f| %>
  <% if platform_staff.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= t("platform_staffs.errors_header", count: platform_staff.errors.count) %></h2>
      <ul>
        <% platform_staff.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="mb-3">
    <legend><%= t("platform_staffs.form_user_data") %></legend>
    <div class="row">
      <div class="col-md-6">
        <%= f.fields_for :user do |u| %>
          <div class="mb-2">
            <%= u.label :firstname, t("platform_staffs.firstname") %>
            <%= u.text_field :firstname, class: 'form-control' %>
          </div>
          <div class="mb-2">
            <%= u.label :lastname, t("platform_staffs.lastname") %>
            <%= u.text_field :lastname, class: 'form-control' %>
          </div>
          <div class="mb-2">
            <%= u.label :email, t("platform_staffs.email") %>
            <%= u.email_field :email, class: 'form-control' %>
          </div>
          <% if platform_staff.new_record? || platform_staff.user&.encrypted_password.blank? %>
            <div class="mb-2">
              <%= u.label :password, t("platform_staffs.password") %>
              <%= u.password_field :password, class: 'form-control' %>
            </div>
            <div class="mb-2">
              <%= u.label :password_confirmation, t("platform_staffs.password_confirmation") %>
              <%= u.password_field :password_confirmation, class: 'form-control' %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("platform_staffs.form_profile") %></legend>
    <div class="row">
      <div class="col-md-6">
        <div class="mb-2">
          <%= f.label :title, PlatformStaff.human_attribute_name(:title) %>
          <%= f.text_field :title, class: 'form-control' %>
        </div>
        <div class="mb-2">
          <%= f.label :contact_number, PlatformStaff.human_attribute_name(:contact_number) %>
          <%= f.text_field :contact_number, class: 'form-control' %>
        </div>
        <div class="mb-2">
          <%= f.label :contact_address, PlatformStaff.human_attribute_name(:contact_address) %>
          <%= f.text_field :contact_address, class: 'form-control' %>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="mt-3">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>
