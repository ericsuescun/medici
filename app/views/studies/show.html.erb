<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>
      <div>
        <%= link_to t("studies.edit_this_study"), edit_study_path(@study) %> |
        <%= link_to t("studies.return_to_studies"), studies_path %>
        <% if policy(Campaign).index? %>
          | <%= link_to t("campaigns.index_title"), study_campaigns_path(@study) %>
        <% end %>
        <% if current_user&.admin? %>
          | <%= link_to t("studies.change_control"), change_control_path("Study", @study.id) %>
        <% end %>

        <%= button_to t("common.delete"), @study, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <%= render @study %>

      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><%= CriteriaProfile.model_name.human %></h5>
          <% if (profile = @study.criteria_profile) %>
            <%= button_to t("studies.unset_profile"), unset_criteria_profile_study_path(@study), method: :delete, class: 'btn btn-sm btn-outline-danger', data: { confirm: t("studies.confirm_unset_profile") } %>
          <% end %>
        </div>
        <div class="card-body">
          <% if profile.present? %>
            <div class="mb-3">
              <h6 class="mb-1"><%= link_to profile.name, criteria_profile_path(profile) %></h6>
              <% if profile.description.present? %>
                <p class="text-muted"><%= profile.description %></p>
              <% end %>
            </div>

            <% variables = profile.criteria_variables.order(Arel.sql("CASE WHEN variable_type = 'inclusion' THEN 0 ELSE 1 END, COALESCE(criteria_order, 2147483647) ASC"), :name) %>
            <% if variables.any? %>
              <div class="table-responsive">
                <table class="table table-striped">
                  <thead>
                  <tr>
                    <th><%= CriteriaVariable.human_attribute_name(:criteria_order) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:name) %></th>
                    <th><%= CriteriaProfile.human_attribute_name(:description) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:value_type) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:variable_type) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:comparison_type) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:reference_value_1) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:reference_value_2) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:conditions) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:qualitative_scale) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:qualitative_value) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:enabled) %></th>
                    <th><%= CriteriaVariable.human_attribute_name(:shown) %></th>
                  </tr>
                  </thead>
                  <tbody>
                  <% variables.each do |variable| %>
                    <tr>
                      <td><%= variable.criteria_order.present? ? variable.criteria_order : '-' %></td>
                      <td><%= link_to variable.name, [profile, variable] %></td>
                      <td><%= variable.description %></td>
                      <td><%= t_enum(variable, :value_type) %></td>
                      <td>
                        <% if variable.variable_type == "inclusion" %>
                          <span class="badge bg-success"><%= t_enum(variable, :variable_type) %></span>
                        <% else %>
                          <span class="badge bg-danger"><%= t_enum(variable, :variable_type) %></span>
                        <% end %>
                      </td>
                      <td><%= t_enum(variable, :comparison_type) %></td>
                      <td><%= variable.reference_value_1 %></td>
                      <td><%= variable.reference_value_2 %></td>
                      <td><%= variable.conditions.presence || '-' %></td>
                      <td><%= (variable.qualitative_scale || []).join(', ') %></td>
                      <td><%= variable.qualitative_value %></td>
                      <td>
                        <% if variable.enabled? %>
                          <span class="badge bg-success"><%= t("common.yes") %></span>
                        <% else %>
                          <span class="badge bg-secondary"><%= t("common.no") %></span>
                        <% end %>
                      </td>
                      <td>
                        <% if variable.shown? %>
                          <span class="badge bg-success"><%= t("common.yes") %></span>
                        <% else %>
                          <span class="badge bg-secondary"><%= t("common.no") %></span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="alert alert-info"><%= t("studies.profile_no_variables") %></div>
            <% end %>
          <% else %>
            <% available_profiles = CriteriaProfile.order(:name) %>
            <% if available_profiles.any? %>
              <%= form_with url: set_criteria_profile_study_path(@study), method: :post, class: 'row g-3 align-items-end' do |f| %>
                <div class="col-md-6">
                  <label for="criteria_profile_id" class="form-label"><%= t("studies.select_profile") %></label>
                  <%= select_tag :criteria_profile_id, options_from_collection_for_select(available_profiles, :id, :name), include_blank: t("studies.select_profile_prompt"), class: 'form-select' %>
                </div>
                <div class="col-md-3">
                  <button type="submit" class="btn btn-primary"><%= t("studies.associate_profile") %></button>
                </div>
                <div class="col-12">
                  <small class="text-muted"><%= t("studies.select_profile_help") %></small>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted mb-0"><%= t("studies.no_profiles_available") %> <%= link_to t("studies.create_profile"), new_criteria_profile_path %>.</p>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
