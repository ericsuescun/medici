<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>
      <div>
        <%= link_to "Editar este estudio", edit_study_path(@study) %> |
        <%= link_to "Retornar a Estudios", studies_path %>
        <% if current_user&.admin? %>
          | <%= link_to "Control de cambios", change_control_path("Study", @study.id) %>
        <% end %>

        <%= button_to "Borrar", @study, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <%= render @study %>

      <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Perfil de Criterios</h5>
          <% if (profile = @study.criteria_profile) %>
            <%= button_to 'Desasociar perfil', unset_criteria_profile_study_path(@study), method: :delete, class: 'btn btn-sm btn-outline-danger', data: { confirm: '¿Seguro que deseas desasociar el perfil?' } %>
          <% end %>
        </div>
        <div class="card-body">
          <% if profile.present? %>
            <div class="mb-3">
              <h6 class="mb-1"><%= link_to profile.name, criteria_profile_path(profile) %></h6>
              <% if profile.description.present? %>
                <p class="text-muted"><%= profile.description %></p>
              <% end %>
            </div>

            <% variables = profile.criteria_variables.order(Arel.sql("CASE WHEN variable_type = 'inclusion' THEN 0 ELSE 1 END, COALESCE(criteria_order, 2147483647) ASC"), :name) %>
            <% if variables.any? %>
              <div class="table-responsive">
                <table class="table table-striped">
                  <thead>
                  <tr>
                    <th>Orden</th>
                    <th>Nombre</th>
                    <th>Descripcion</th>
                    <th>Tipo</th>
                    <th>Tipo de regla</th>
                    <th>Comparación</th>
                    <th>Ref 1</th>
                    <th>Ref 2</th>
                    <th>Condiciones</th>
                    <th>Escala cualitativa</th>
                    <th>Valor cualitativo</th>
                    <th>Habilitada</th>
                    <th>Visible</th>
                  </tr>
                  </thead>
                  <tbody>
                  <% variables.each do |variable| %>
                    <tr>
                      <td><%= variable.criteria_order.present? ? variable.criteria_order : '-' %></td>
                      <td><%= link_to variable.name, [profile, variable] %></td>
                      <td><%= variable.description %></td>
                      <td><%= variable.value_type %></td>
                      <td>
                        <% if variable.variable_type == "inclusion" %>
                          <span class="badge bg-success">inclusion</span>
                        <% else %>
                          <span class="badge bg-danger">exclusion</span>
                        <% end %>
                      </td>
                      <td><%= variable.comparison_type %></td>
                      <td><%= variable.reference_value_1 %></td>
                      <td><%= variable.reference_value_2 %></td>
                      <td><%= variable.conditions.presence || '-' %></td>
                      <td><%= (variable.qualitative_scale || []).join(', ') %></td>
                      <td><%= variable.qualitative_value %></td>
                      <td>
                        <% if variable.enabled? %>
                          <span class="badge bg-success">Sí</span>
                        <% else %>
                          <span class="badge bg-secondary">No</span>
                        <% end %>
                      </td>
                      <td>
                        <% if variable.shown? %>
                          <span class="badge bg-success">Sí</span>
                        <% else %>
                          <span class="badge bg-secondary">No</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="alert alert-info">Este perfil no tiene variables aún.</div>
            <% end %>
          <% else %>
            <% available_profiles = CriteriaProfile.order(:name) %>
            <% if available_profiles.any? %>
              <%= form_with url: set_criteria_profile_study_path(@study), method: :post, class: 'row g-3 align-items-end' do |f| %>
                <div class="col-md-6">
                  <label for="criteria_profile_id" class="form-label">Seleccionar perfil</label>
                  <%= select_tag :criteria_profile_id, options_from_collection_for_select(available_profiles, :id, :name), include_blank: 'Seleccione un perfil', class: 'form-select' %>
                </div>
                <div class="col-md-3">
                  <button type="submit" class="btn btn-primary">Asociar perfil</button>
                </div>
                <div class="col-12">
                  <small class="text-muted">Selecciona un perfil para asociarlo a este estudio. Solo un perfil puede estar asociado a la vez.</small>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted mb-0">No hay perfiles disponibles para asociar. <%= link_to 'Crear un perfil', new_criteria_profile_path %>.</p>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
