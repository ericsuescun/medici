<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <% content_for :title, t("studies.clinical_studies") %>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><%= t("studies.clinical_studies") %></h1>
        <div>
          <%= link_to t("studies.return_to_vitalia"), static_pages_medici_home_path %> |
          <%= link_to t("studies.new_study"), new_study_path %>
        </div>
      </div>
      
      <div class="card mb-4">
        <div class="card-body p-0">
          <div class="table">
            <table class="table table-striped mb-0">
              <thead>
              <tr>
                <th><%= Study.human_attribute_name(:scientific_title) %></th>
                <th><%= Study.human_attribute_name(:sponsor) %></th>
                <th><%= TrialCenterFacility.model_name.human %></th>
                <th><%= City.model_name.human %></th>
                <th><%= Patient.model_name.human %></th>
                <th><%= Study.human_attribute_name(:study_status) %></th>
                <th><%= Study.human_attribute_name(:completed_at) %></th>
              </tr>
              </thead>
              <tbody>
              <% @studies.order(:study_status).each do |study| %>
                <tr>
                  <td>
                    <%= render "studies/recruitment_bar", study: study, progress: @recruitment&.fetch(study.id, nil) %>
                    <strong><%= link_to study.scientific_title, study %></strong>
                  </td>
                  <td><%= link_to study.sponsor.name, study.sponsor %></td>
                  <td><%= study.trial_center_facilities.count %></td>
                  <td><%= study.cities_names.count %></td>
                  <td><span class="badge bg-primary"><%= study.patients.count %></span></td>
                  <td>
                    <% status_class = case study.study_status 
                                      when "completed" then "bg-secondary"
                                      when "recruiting" then "bg-primary"
                                      else "bg-warning" 
                                      end %>
                    <span class="badge <%= status_class %>"><%= t_enum(study, :study_status) %></span>
                  </td>
                  <td><%= study.completed_at&.strftime("%d/%m/%Y") %></td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <div class="d-flex justify-content-between align-items-center">
        <%= will_paginate @studies, :renderer => WillPaginate::ActionView::Bootstrap4LinkRenderer %>
        <div>
          <%= link_to t("studies.return_to_vitalia"), static_pages_medici_home_path %> |
          <%= link_to t("studies.new_study"), new_study_path %>
        </div>
      </div>
    </div>
  </div>
</div>
