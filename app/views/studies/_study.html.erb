<div class="card">
  <div class="card-header">
    <h1 class="card-title"><strong><%= study.public_title %></strong></h1>
    <h2 class="card-subtitle mb-2 text-body-secondary"><strong><%= study.scientific_title %></strong></h2>
    <h3 class="card-subtitle mb-2 text-body-secondary"><strong>Short Title: <%= study.short_title %></strong></h3>
  </div>
  <div class="card-body">
    <p class="card-text">
    <h6><strong>Sujetos interesados en el estudio:</strong> <%= study.users.count %></h6>
    <div class="row">
      <div class="col-3">
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Nombre</th>
            <th>Edad</th>
          </tr>
          </thead>
          <tbody>
          <% @patients.each do |patient| %>
            <tr>
              <td><%= link_to patient.fullname, patient %></td>
              <td><%= get_age(patient.dob) %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <p><strong>Ensayos Clinicos:</strong></p>

    <div class="row">
      <div class="col-6">
        <!-- Display existing trial center branches -->
        <div class="mb-4">
          <h5>Centros y Sucursales Asociados:</h5>
          <% if study.trial_center_branches.any? %>
            <table class="table table-striped">
              <thead>
              <tr>
                <th>Centro</th>
                <th>Sucursal</th>
                <th>Ciudades</th>
                <th>Acciones</th>
              </tr>
              </thead>
              <tbody>
              <% study.trial_center_branches.sort_by { |branch| branch.cities.pluck(:name).join(', ') }.each do |branch| %>
                <tr>
                  <td><%= link_to branch.trial_center_facility.name, branch.trial_center_facility, class: "card-link" %></td>
                  <td><%= link_to branch.name, branch, class: "card-link" %></td>
                  <td><%= branch.cities.pluck(:name).join(', ') %></td>
                  <td>
                    <% if study.trial_center_branches.count > 1 %>
                      <%= button_to "Eliminar", remove_trial_center_branch_study_path(study, trial_center_branch_id: branch.id),
                                    method: :delete,
                                    class: "btn btn-danger btn-sm",
                                    data: { confirm: "¿Está seguro de eliminar esta sucursal?" } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <p>No hay sucursales asociadas a este estudio.</p>
          <% end %>
        </div>
      </div>
      <div class="col-6">
        <!-- Form to add a new trial center branch -->
        <div class="card mb-4">
          <div class="card-header">
            <h5>Agregar Sucursal al Estudio</h5>
          </div>
          <div class="card-body">
            <%= form_with url: add_trial_center_branch_study_path(study), method: :post, class: "row g-3" do |form| %>
              <div class="col-md-12">
                <label for="trial_center_branch_id" class="form-label">Seleccionar Sucursal (por Ciudad)</label>
                <select name="trial_center_branch_id" id="trial_center_branch_id" class="form-select" required>
                  <option value="">Seleccionar una sucursal...</option>
                  <% @trial_center_branches.sort_by { |branch| branch.cities.pluck(:name).join(', ') }.each do |branch| %>
                    <option value="<%= branch.id %>">
                      <%= branch.name %> - <%= branch.trial_center_facility.name %>
                      (<%= branch.cities.pluck(:name).join(', ') %>)
                    </option>
                  <% end %>
                </select>
              </div>
              <div class="col-12">
                <%= form.submit "Agregar Sucursal", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-6">
        <!-- Display existing medications -->
        <div class="mb-4">
          <h5>Medicamentos Asociados:</h5>
          <% if study.medications.any? %>
            <table class="table table-striped">
              <thead>
              <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
              </tr>
              </thead>
              <tbody>
              <% study.medications.each do |medication| %>
                <tr>
                  <td><strong><%= medication.name %></strong></td>
                  <td><%= medication.description %></td>
                  <td>
                    <% if study.medications.count > 1 %>
                      <%= button_to "Eliminar", remove_medication_study_path(study, medication_id: medication.id),
                                    method: :delete,
                                    class: "btn btn-danger btn-sm",
                                    data: { confirm: "¿Está seguro de eliminar este medicamento?" } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <p>No hay medicamentos asociados a este estudio.</p>
          <% end %>
        </div>
      </div>
      <div class="col-6">
        <!-- Form to add a new medication -->
        <div class="card mb-4">
          <div class="card-header">
            <h5>Agregar Medicamento al Estudio</h5>
          </div>
          <div class="card-body">
            <%= form_with url: add_medication_study_path(study), method: :post, class: "row g-3" do |form| %>
              <div class="col-md-12">
                <label for="medication_id" class="form-label">Seleccionar Medicamento</label>
                <select name="medication_id" id="medication_id" class="form-select" required>
                  <option value="">Seleccionar un medicamento...</option>
                  <% Medication.all.each do |medication| %>
                    <option value="<%= medication.id %>">
                      <%= medication.name %> - <%= medication.description %>
                    </option>
                  <% end %>
                </select>
              </div>
              <div class="col-12">
                <%= form.submit "Agregar Medicamento", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <h4>Identificacion del estudio</h4>
    <table class="table table-striped">
      <thead>
      <tr>
        <th>Completed at</th>
        <th>Started at</th>
        <th>First patient at</th>
        <th>Global ending at</th>
      </tr>
      </thead>
      <tbody>
      <tr>
        <td><%= study.completed_at %></td>
        <td><%= study.started_at %></td>
        <td><%= study.first_patient_at %></td>
        <td><%= study.global_ending_at %></td>
      </tr>

      </tbody>
    </table>
    <div class="row">
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Informacion del patrocinador</h5>
          </div>
          <div class="card-body">
            <p><strong>Sponsors: </strong><%= study.sponsor.name %></p>
            <p><strong>Sponsor type: </strong><%= study.sponsor.sponsor_type %></p>
            <p><strong>Study status: </strong><%= study.study_status %></p>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Diseno del Estudio</h5>
          </div>
          <div class="card-body">
            <p><strong>Study phase: </strong><%= study.study_phase %></p>
            <p><strong>Inclusion criteria: </strong><%= study.inclusion_criteria %></p>
            <p><strong>Exclusion criteria: </strong><%= study.exclusion_criteria %></p>
            <p><strong>Sample size: </strong><%= study.sample_size %></p>
            <p><strong>Main intervention: </strong><%= study.main_intervention %></p>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Resultados Primarios y Secundarios</h5>
          </div>
          <div class="card-body">
            <p><strong>Primarios:  </strong></p>
            <% study.results.primary.each do |result| %>
              <p><strong>Titulo: </strong><%= result.title %></p>
              <p><%= result.description %></p>
            <% end %>
            <p><strong>Secundarios:  </strong></p>
            <% study.results.secondary.each do |result| %>
              <p><strong>Titulo: </strong><%= result.title %></p>
              <p><%= result.description %></p>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Poblacion del estudio</h5>
          </div>
          <div class="card-body">
            <p><strong>Sex: </strong><%= study.sex %></p>
          </div>
        </div>
        <div class="card mt-3">
          <div class="card-header">
            <h5>Revisiones</h5>
          </div>
          <div class="card-body">
            <p><strong>Reviewed: </strong><%= study.reviewed %></p>
            <p><strong>Review user: </strong><%= study.review_user_id %></p>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Informacion de contacto</h5>
          </div>
          <div class="card-body">
            <% study.contacts.each do |contact|%>
              <p><span><%= contact.contact_info %> </span></p>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Enlaces a publicaciones</h5>
          </div>
          <div class="card-body">
          </div>
        </div>
      </div>
    </div>
    </p>
  </div>
</div>

</div>
