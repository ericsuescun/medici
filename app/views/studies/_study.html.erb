<div class="card">
  <div class="card-header">
    <h1 class="card-title"><strong><%= study.public_title %></strong></h1>
    <h2 class="card-subtitle mb-2 text-body-secondary"><strong><%= study.scientific_title %></strong></h2>
  </div>
  <div class="card-body">
    <p class="card-text">
    <h6><strong>Sujetos interesados en el estudio:</strong> <%= study.users.count%></h6>

    <% study.trial_center_facilities.each do |tcf| %>
      <p><strong>Centro de Ensayos Clinicos:</strong> <%= link_to tcf.name, tcf, class: "card-link" %></p>
      <p><strong>Ciudades:</strong> <%= tcf.cities.pluck(:name).join(', ') %></p>
    <% end %>

    <h4>Identificacion del estudio</h4>
    <table class="table table-striped">
      <thead>
      <tr>
        <th>INVIMA</th>
        <th>Registrated at</th>
        <th>Approved at</th>
        <th>Started at</th>
        <th>First patient at</th>
        <th>Global ending at</th>
      </tr>
      </thead>
      <tbody>
      <tr>
        <td><%= study.local_unique_register %></td>
        <td><%= study.registered_at %></td>
        <td><%= study.approved_at %></td>
        <td><%= study.started_at %></td>
        <td><%= study.first_patient_at %></td>
        <td><%= study.global_ending_at %></td>
      </tr>

      </tbody>
    </table>
    <div class="row">
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Informacion del patrocinador</h5>
          </div>
          <div class="card-body">
            <p><strong>Sponsors: </strong><%= study.sponsor.name %></p>
            <p><strong>Sponsor type: </strong><%= study.sponsor.sponsor_type %></p>
            <p><strong>Study status: </strong><%= study.study_status %></p>
          </div>
        </div>
        <div class="card mt-3">
          <div class="card-header">
            <h5>Aspectos Eticos</h5>
          </div>
          <div class="card-body">
            <p><strong>Ethical committee: </strong><%= study.ethical_committee %></p>
            <p><strong>Ethical approval at: </strong><%= study.ethical_approval_at %></p>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Diseno del Estudio</h5>
          </div>
          <div class="card-body">
            <p><strong>Study type: </strong><%= study.study_type %></p>
            <p><strong>Study phase: </strong><%= study.study_phase %></p>
            <p><strong>Inclusion criteria: </strong><%= study.inclusion_criteria %></p>
            <p><strong>Exclusion criteria: </strong><%= study.exclusion_criteria %></p>
            <p><strong>Sample size: </strong><%= study.sample_size %></p>
            <p><strong>Main intervention: </strong><%= study.main_intervention %></p>
            <p><strong>Control group: </strong><%= study.control_group %></p>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Resultados Primarios y Secundarios</h5>
          </div>
          <div class="card-body">
            <p><strong>Primarios:  </strong></p>
            <% study.results.primary.each do |result| %>
              <p><strong>Titulo: </strong><%= result.title %></p>
              <p><%= result.description %></p>
            <% end %>
            <p><strong>Secundarios:  </strong></p>
            <% study.results.secondary.each do |result| %>
              <p><strong>Titulo: </strong><%= result.title %></p>
              <p><%= result.description %></p>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Poblacion del estudio</h5>
          </div>
          <div class="card-body">
            <p><strong>Participant starting age: </strong><%= study.participant_starting_age %></p>
            <p><strong>Participant ending age: </strong><%= study.participant_ending_age %></p>
            <p><strong>Sex: </strong><%= study.sex %></p>
            <p><strong>Medical preexistence: </strong><%= study.medical_preexistence %></p>
          </div>
        </div>
        <div class="card mt-3">
          <div class="card-header">
            <h5>Revisiones</h5>
          </div>
          <div class="card-body">
            <p><strong>Reviewed: </strong><%= study.reviewed %></p>
            <p><strong>Review user: </strong><%= study.review_user_id %></p>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Informacion de contacto</h5>
          </div>
          <div class="card-body">
            <% study.contacts.each do |contact|%>
              <p><span><%= contact.contact_info %> </span></p>
            <% end %>
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Enlaces a publicaciones</h5>
          </div>
          <div class="card-body">
          </div>
        </div>
      </div>
      <div class="col-3">
        <div class="card mt-3">
          <div class="card-header">
            <h5>Criterios de busqueda</h5>
          </div>
          <div class="card-body">
            <p><strong>Keywords: </strong><%= study.keywords %></p>
            <p><strong>Pathology: </strong><%= study.pathology %></p>
            <p><strong>Medication: </strong><%= study.medication %></p>
          </div>
        </div>
      </div>
    </div>
    </p>
  </div>
</div>

</div>
