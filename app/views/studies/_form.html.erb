<%= form_with(model: study) do |form| %>
  <% if study.errors.any? %>
    <div style="color: red">
      <h2><%= t("studies.errors_prohibited_save", count: study.errors.count) %></h2>

      <ul>
        <% study.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<%# Study type + the single approval question that follows from it. On a new
    study the type came from the index's per-type button, so it travels as a
    hidden field (with a link back to change it); on an existing study it is
    editable, and switching it re-renders with the other approval question. %>
<div class="card health-card shadow-sm mb-4">
  <div class="card-body">
    <% if study.persisted? %>
      <div class="mb-3">
        <%= form.label :study_type, class: "form-label" %>
        <%= form.select :study_type,
                        Study.study_types.keys.map { |type| [ t("studies.types.#{type}"), type ] },
                        {}, class: "form-select" %>
        <div class="form-text"><%= t("studies.form.study_type_help") %></div>
      </div>
    <% else %>
      <%= form.hidden_field :study_type %>
      <p class="mb-3">
        <span class="text-muted"><%= Study.human_attribute_name(:study_type) %>:</span>
        <strong><%= t("studies.types.#{study.study_type}") %></strong>
        <%= link_to t("studies.form.change_study_type"), studies_path, class: "small ms-2" %>
      </p>
    <% end %>

    <%# Observational research answers to the ethics committee; interventional
        research answers to the local health authority, named from the
        local_parameters table (INVIMA in Colombia) instead of a cryptic key. %>
    <% if study.observational? %>
      <div class="form-check">
        <%= form.check_box :committee_approved, class: "form-check-input" %>
        <%= form.label :committee_approved, t("studies.form.committee_approved"), class: "form-check-label" %>
      </div>
    <% else %>
      <% authority = LocalParameter.health_authority_label %>
      <div class="form-check">
        <%= form.check_box :local_health_authority_approved, class: "form-check-input" %>
        <%= form.label :local_health_authority_approved,
              (authority.present? ? t("studies.form.authority_approved", authority: authority) : t("studies.form.local_health_authority_approved")),
              class: "form-check-label" %>
      </div>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-6">
    <div>
      <%= form.label :public_title, style: "display: block" %>
      <%= form.text_field :public_title, class: "form-control mb-3" %>
    </div>

    <div>
      <%= form.label :scientific_title, style: "display: block" %>
      <%= form.text_field :scientific_title, class: "form-control mb-3" %>
    </div>

    <div>
      <%= form.label :short_title, style: "display: block" %>
      <%= form.text_field :short_title, class: "form-control mb-3" %>
    </div>

    <div>
      <%= form.label :category_ids, Category.model_name.human(count: 2), style: "display: block" %>
      <%# Therapeutic areas (seeded reference list). Ctrl/Cmd-click for more
          than one; convention is 1–3 per study. %>
      <%= form.collection_select :category_ids, Category.order(:name), :id, :name, {},
          { multiple: true, class: "form-select mb-3", size: 8 } %>
      <div class="form-text mb-3"><%= t("studies.form.categories_help") %></div>
    </div>

    <div>
      <%= form.label :study_status, style: "display: block" %>
      <%= form.select(:study_status,
                      [['Completed', 'completed'], ['Recruiting', 'recruiting']],
                      { include_blank: true }, class: "form-select mb-3") %>
    </div>

    <div>
      <%= form.label :completed_at, style: "display: block" %>
      <%= form.date_field :completed_at, class: "form-control mb-3 input" %>
    </div>

    <div>
      <%= form.label :started_at, style: "display: block" %>
      <%= form.date_field :started_at, class: "form-control mb-3 input" %>
    </div>

    <div>
      <%= form.label :first_patient_at, style: "display: block" %>
      <%= form.date_field :first_patient_at, class: "form-control mb-3 input" %>
    </div>

    <div>
      <%= form.label :global_ending_at, style: "display: block" %>
      <%= form.date_field :global_ending_at, class: "form-control mb-3 input" %>
    </div>
  </div>
  <div class="col-6">
    <div>
      <%= form.label :study_phase, style: "display: block" %>
      <%= form.select(:study_phase,
                      [['I', 'I'], ['II', 'II'], ['III', 'III'], ['IV', 'IV']],
                      { include_blank: true }, class: "form-select mb-3") %>
    </div>

    <div>
      <%= form.label :inclusion_criteria, style: "display: block" %>
      <%= form.text_field :inclusion_criteria, class: "form-control mb-3" %>
    </div>

    <div>
      <%= form.label :exclusion_criteria, style: "display: block" %>
      <%= form.text_field :exclusion_criteria, class: "form-control mb-3" %>
    </div>

    <div>
      <%= form.label :sample_size, style: "display: block" %>
      <%= form.number_field :sample_size, class: "form-control mb-3 input" %>
    </div>

    <div>
      <%= form.label :main_intervention, style: "display: block" %>
      <%= form.text_field :main_intervention, class: "form-control mb-3" %>
    </div>

    <div>
      <%= form.label :sex, style: "display: block" %>
        <%= form.select(:sex,
                      [['F', 'F'], ['M', 'M']],
                      { include_blank: true }, class: "form-select mb-3") %>
    </div>
    <div class="form-group">
      <%= form.label :sponsor_id, Sponsor.model_name.human %>
      <%= form.select :sponsor_id, @sponsors.pluck(:name, :id), { }, class: "form-select mb-3" %>
    </div>

    <div class="form-group">
      <%= form.label :trial_center_branch_id, TrialCenterBranch.model_name.human %>
      <%= form.select :trial_center_branch_id, @trial_center_branches.pluck(:name, :id), { }, class: "form-select mb-3" %>
    </div>
    <div>
      <%= form.label :reviewed, style: "display: block" %>
      <%= form.check_box :reviewed %>
    </div>
  </div>

</div>
  <div>
    <%= form.submit t("common.save"), class: 'btn btn-primary btn-block' %>
  </div>
<% end %>
