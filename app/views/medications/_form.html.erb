<%= form_with(model: medication) do |f| %>
  <% if medication.errors.any? %>
    <div style="color: red">
      <h2><%= t("medications.form_errors", count: medication.errors.count) %></h2>
      <ul>
        <% medication.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6">
      <div class="mb-2">
        <%= f.label :name %>
        <%= f.text_field :name, class: 'form-control' %>
      </div>
      <div class="mb-2">
        <%= f.label :description %>
        <%= f.text_area :description, rows: 4, class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>
