<%# The form partial opens with a .row, whose negative gutter margins need a
    container to offset them — without one the row overflows the viewport and
    the whole page scrolls sideways. Matches the wrapper every other view uses. %>
<div class="container-fluid">
  <h1><%= t("common.new") %> <%= Medication.model_name.human %></h1>
  <%= render 'form', medication: @medication %>
  <%= link_to t("common.back"), medications_path %> |
  <%= link_to t("medications.home_link"), static_pages_medici_home_path %>
</div>
