<div class="container">
  <p style="color: green"><%= notice %></p>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= t("nav.medications") %></h1>
    <div>
      <%= link_to t("medications.home_link"), static_pages_medici_home_path %>
      <% if policy(Medication).new? %>
        | <%= link_to t("medications.new"), new_medication_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <table class="table table-striped">
    <thead>
    <tr>
      <th><%= Medication.human_attribute_name(:name) %></th>
      <th><%= Medication.human_attribute_name(:description) %></th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @medications.each do |m| %>
      <tr>
        <td><%= link_to m.name, medication_path(m) %></td>
        <td class="text-truncate" style="max-width: 400px"><%= m.description %></td>
        <td>
          <% if policy(m).edit? %>
            <%= link_to t("common.edit"), edit_medication_path(m), class: 'btn btn-sm btn-outline-secondary' %>
          <% end %>
          <% if policy(m).destroy? %>
            <%= button_to t("common.destroy"), medication_path(m), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: t("medications.confirm_delete") } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>

</div>
