<div class="container">
  <p style="color: green"><%= notice %></p>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Medicamentos</h1>
    <div>
      <%= link_to "Retornar a Vitalia", static_pages_medici_home_path %>
      <% if policy(Medication).new? %>
        | <%= link_to "Nuevo medicamento", new_medication_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <table class="table table-striped">
    <thead>
    <tr>
      <th>Nombre</th>
      <th>Descripción</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @medications.each do |m| %>
      <tr>
        <td><%= link_to m.name, medication_path(m) %></td>
        <td class="text-truncate" style="max-width: 400px"><%= m.description %></td>
        <td>
          <% if policy(m).edit? %>
            <%= link_to 'Editar', edit_medication_path(m), class: 'btn btn-sm btn-outline-secondary' %>
          <% end %>
          <% if policy(m).destroy? %>
            <%= button_to 'Eliminar', medication_path(m), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: '¿Eliminar este medicamento?' } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>

</div>
