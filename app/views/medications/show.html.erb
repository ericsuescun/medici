<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @medication.name %></h3>
  </div>
  <div class="card-body">
    <p><strong><%= Medication.human_attribute_name(:description) %>:</strong></p>
    <p><%= simple_format(@medication.description) %></p>

    <% if @medication.studies.any? %>
      <hr/>
      <h5><%= t("medications.related_studies") %></h5>
      <ul>
        <% @medication.studies.each do |s| %>
          <li><%= link_to s.short_title.presence || s.public_title, study_path(s) %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<div class="mt-3">
  <%= link_to t("medications.edit_this"), edit_medication_path(@medication) %> |
  <%= link_to t("medications.back_to_list"), medications_path %> |
  <%= link_to t("medications.home_link"), static_pages_medici_home_path %>
  <%= button_to t("medications.delete_this"), @medication, method: :delete, class: "btn btn-danger ms-2" %>
</div>
