<div class="container mt-4">
  <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
  <% if alert %><div class="alert alert-danger"><%= alert %></div><% end %>

  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-1">
    <h1 class="mb-0"><%= t("criteria_assessments.evaluation_title") %></h1>
    <span class="badge rounded-pill bg-light text-dark border align-self-center">
      <%= Patient.human_attribute_name(:state) %>: <strong><%= t("patients.states.#{@patient.state}", default: @patient.state) %></strong>
    </span>
  </div>
  <p class="text-muted mb-4">
    <%= @profile.name %><% if @profile.study %> · <%= Study.model_name.human %>: <%= @profile.study.public_title %><% end %>
  </p>

  <%# ---- Verdict banner (primary criteria) + secondary advisory ---- %>
  <%= render "criteria_assessments/verdict_banner", result: @result %>
  <%= render "criteria_assessments/secondary_warning", result: @result %>

  <%# ---- Recruitment score: primary criteria only ---- %>
  <div class="mb-4">
    <%= render "criteria_assessments/score_card", result: @result %>
  </div>

  <%# ---- Brief: at-a-glance counts (whole profile, both categories) ---- %>
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card h-100 text-center p-3 border rounded">
        <div class="fs-3 fw-bold text-success"><%= @result.passing.count %></div>
        <div class="text-muted small"><%= t("criteria_assessments.brief.passing") %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card h-100 text-center p-3 border rounded">
        <div class="fs-3 fw-bold text-danger"><%= @result.failing.count %></div>
        <div class="text-muted small"><%= t("criteria_assessments.brief.out_of_reach") %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card h-100 text-center p-3 border rounded">
        <div class="fs-3 fw-bold text-secondary"><%= @result.pending.count %></div>
        <div class="text-muted small"><%= t("criteria_assessments.brief.pending") %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card h-100 text-center p-3 border rounded">
        <div class="fs-3 fw-bold"><%= @result.answered_count %>/<%= @result.total_count %></div>
        <div class="text-muted small"><%= t("criteria_assessments.brief.answered") %></div>
      </div>
    </div>
  </div>

  <%# ---- Brief: what blocks / what's left, so the investigator sees it at a glance ---- %>
  <% if @result.failing.any? || @result.pending.any? %>
    <div class="row g-3 mb-4">
      <% if @result.failing.any? %>
        <div class="col-md-6">
          <div class="card border-danger h-100">
            <div class="card-header bg-danger-subtle text-danger-emphasis fw-semibold">
              <%= t("criteria_assessments.brief.out_of_reach_heading", count: @result.failing.count) %>
            </div>
            <ul class="list-group list-group-flush">
              <% @result.failing.each do |c| %>
                <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
                  <span>
                    <strong><%= c.variable.name %></strong>
                    <span class="badge bg-light text-dark border ms-1"><%= c.variable.variable_type == "exclusion" ? Study.human_attribute_name(:exclusion_criteria) : Study.human_attribute_name(:inclusion_criteria) %></span>
                    <span class="badge border ms-1 <%= c.primary? ? "bg-primary-subtle text-primary-emphasis" : "bg-light text-secondary" %>"><%= t_enum(c.variable, :criteria_category) %></span>
                    <div class="small text-muted">
                      <%= t("criteria_assessments.brief.required") %>: <%= c.variable.rule_summary %> ·
                      <%= t("criteria_assessments.brief.measured") %>: <span class="text-danger fw-semibold"><%= c.value %></span>
                    </div>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <% if @result.pending.any? %>
        <div class="col-md-6">
          <div class="card border-secondary h-100">
            <div class="card-header bg-secondary-subtle text-secondary-emphasis fw-semibold">
              <%= t("criteria_assessments.brief.pending_heading", count: @result.pending.count) %>
            </div>
            <ul class="list-group list-group-flush">
              <% @result.pending.each do |c| %>
                <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
                  <span>
                    <strong><%= c.variable.name %></strong>
                    <span class="badge bg-light text-dark border ms-1"><%= c.variable.variable_type == "exclusion" ? Study.human_attribute_name(:exclusion_criteria) : Study.human_attribute_name(:inclusion_criteria) %></span>
                    <span class="badge border ms-1 <%= c.primary? ? "bg-primary-subtle text-primary-emphasis" : "bg-light text-secondary" %>"><%= t_enum(c.variable, :criteria_category) %></span>
                    <div class="small text-muted"><%= t("criteria_assessments.brief.required") %>: <%= c.variable.rule_summary %></div>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ---- Take action: promote the patient through the trial lifecycle ---- %>
  <% forward_event = { "interested" => "assess", "candidate" => "accept" }[@patient.state] %>
  <% forward_allowed = forward_event && policy(@patient).public_send("#{forward_event}?") %>
  <%# A forward step this user's role permits but the PRIMARY criteria block.
      Shown as a disabled button with the reason rather than vanishing, which is
      what would otherwise happen: the AASM guard makes policy.assess? false. %>
  <% locked_forward = forward_event.present? && policy(@patient).update_state? && !@patient.primary_criteria_met? %>
  <% any_transition = locked_forward || %w[assess accept discard reject].any? { |e| policy(@patient).public_send("#{e}?") } %>
  <%# The score drives the recommendation; profiles with no primary criteria
      fall back to the whole-profile verdict, as before the score existed. %>
  <% recommend_forward = @result.recommendation == :none ? @result.eligible? : @result.promotable? %>
  <% if any_transition %>
    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title mb-1"><%= t("criteria_assessments.brief.take_action") %></h5>
        <p class="text-muted small mb-3">
          <% if locked_forward %>
            <% if @result.recommendation != :none %>
              <%= t("criteria_assessments.score.promote_hint_#{@result.recommendation}",
                    score: @result.primary_score, event: t("patients.#{forward_event}")) %>
            <% end %>
            <strong><%= t("criteria_assessments.locked.hint") %></strong>
          <% elsif forward_allowed && @result.recommendation != :none %>
            <%= t("criteria_assessments.score.promote_hint_#{@result.recommendation}",
                  score: @result.primary_score, event: t("patients.#{forward_event}")) %>
          <% elsif forward_allowed && @result.eligible? %>
            <%= t("criteria_assessments.brief.promote_hint_eligible", event: t("patients.#{forward_event}")) %>
          <% elsif forward_allowed && !@result.complete? %>
            <%= t("criteria_assessments.brief.promote_hint_incomplete") %>
          <% elsif forward_allowed %>
            <%= t("criteria_assessments.brief.promote_hint_not_eligible") %>
          <% else %>
            <%= t("criteria_assessments.brief.promote_hint_generic") %>
          <% end %>
        </p>
        <div class="d-flex flex-wrap gap-2">
          <% if locked_forward %>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                    title="<%= t("criteria_assessments.locked.hint") %>">
              <i class="bi bi-lock-fill"></i> <%= t("patients.#{forward_event}") %>
            </button>
          <% end %>
          <% if policy(@patient).assess? %>
            <%= button_to t("patients.assess"), transition_patient_path(@patient, event: "assess"), method: :post,
                          class: "btn btn-sm #{forward_event == 'assess' && recommend_forward ? 'btn-success' : 'btn-outline-primary'}" %>
          <% end %>
          <% if policy(@patient).accept? %>
            <%= button_to t("patients.accept"), transition_patient_path(@patient, event: "accept"), method: :post,
                          class: "btn btn-sm #{forward_event == 'accept' && recommend_forward ? 'btn-success' : 'btn-outline-success'}" %>
          <% end %>
          <% if policy(@patient).discard? %>
            <%= button_to t("patients.discard"), transition_patient_path(@patient, event: "discard"), method: :post, class: "btn btn-sm btn-outline-warning" %>
          <% end %>
          <% if policy(@patient).reject? %>
            <%= button_to t("patients.reject"), transition_patient_path(@patient, event: "reject"), method: :post, class: "btn btn-sm btn-outline-danger" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# ---- Capture values ---- %>
  <% checks_by_var = @result.checks.index_by { |c| c.variable.id } %>

  <%= form_with url: patient_criteria_assessment_path(@patient, criteria_profile_id: @profile.id), method: :patch do %>
    <%# Grouped by category first (decisive criteria on top, because they are the
        ones that move the score), then by inclusion/exclusion as before. %>
    <% @variables.group_by(&:criteria_category).sort_by { |category, _| category == "primary" ? 0 : 1 }.each do |category, category_vars| %>
      <div class="d-flex flex-wrap align-items-baseline gap-2 mt-5 mb-1">
        <h4 class="mb-0"><%= t("criteria_assessments.score.#{category}_section") %></h4>
        <span class="text-muted small"><%= t("criteria_assessments.score.#{category}_section_hint") %></span>
      </div>
      <% category_vars.group_by(&:variable_type).each do |variable_type, vars| %>
      <h6 class="mt-3 text-muted text-uppercase small"><%= variable_type == "inclusion" ? Study.human_attribute_name(:inclusion_criteria) : Study.human_attribute_name(:exclusion_criteria) %></h6>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr><th><%= t("criteria_assessments.criterion") %></th><th><%= t("criteria_assessments.rule") %></th><th><%= t("criteria_assessments.patient_value") %></th><th><%= t("criteria_assessments.status") %></th></tr>
          </thead>
          <tbody>
            <% vars.each do |cv| %>
              <% current = (@values_by_var[cv.id] || @values_by_name[cv.name])&.value %>
              <% status = checks_by_var[cv.id]&.status %>
              <tr>
                <td>
                  <%= cv.name %>
                  <% if (declaration = @declarations_by_variable[cv.id]) %>
                    <div class="small text-muted">
                      <i class="bi bi-chat-left-quote"></i>
                      <% if declaration.declined? %>
                        <%= t("criteria_assessments.declared_dont_know") %>
                      <% else %>
                        <%= t("criteria_assessments.declared", value: declaration.answer) %>
                      <% end %>
                      · <%= l(declaration.declared_at.to_date) %>
                      <% if declaration.recorded_by.nil? %>(<%= t("criteria_assessments.declared_by_patient") %>)<% end %>
                    </div>
                  <% end %>
                </td>
                <td><span class="text-muted"><%= cv.rule_summary %></span></td>
                <td style="max-width: 220px">
                  <% if cv.value_type == "boolean" %>
                    <%= select_tag "values[#{cv.id}]", options_for_select([[t("common.none"), ""], [t("common.yes"), "true"], [t("common.no"), "false"]], current), class: "form-select form-select-sm" %>
                  <% elsif cv.value_type == "qualitative" %>
                    <%= select_tag "values[#{cv.id}]", options_for_select([[t("common.none"), ""]] + Array(cv.qualitative_scale).map { |o| [o, o] }, current), class: "form-select form-select-sm" %>
                  <% else %>
                    <%= number_field_tag "values[#{cv.id}]", current, step: :any, class: "form-control form-control-sm" %>
                  <% end %>
                </td>
                <td>
                  <% if status == :pass %>
                    <span class="badge bg-success"><%= t("criteria_assessments.pass") %></span>
                  <% elsif status == :fail %>
                    <span class="badge bg-danger"><%= t("criteria_assessments.fail") %></span>
                  <% else %>
                    <span class="badge bg-secondary"><%= t("criteria_assessments.no_data") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% end %>
    <% end %>

    <%= submit_tag t("criteria_assessments.save_and_evaluate"), class: "btn btn-success" %>
    <%= link_to t("criteria_assessments.back_to_patient"), patient_path(@patient), class: "btn btn-link" %>
  <% end %>
</div>
