<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Medici" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="layout-debug" content="application layout loaded" />
  </head>

  <body>
    <%= render 'layouts/general_navbar' if current_user.present? && !current_user.patient? %>
    <%= render 'layouts/patient_navbar' if current_user.present? && current_user.patient? %>

    <%# Flashes render for everyone, signed in or not. They used to be wrapped in
        `if user_signed_in?`, which silently swallowed every message shown to an
        anonymous visitor — including the "thank you, a rep will contact you"
        confirmation after submitting the public participation form, so people
        had no idea their details had gone through. %>
    <% if flash[:notice] %>
      <div class="alert alert-warning mt-2"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div class="alert alert-danger mt-2"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:message] %>
      <div class="alert alert-info mt-2"><%= flash[:message] %></div>
    <% end %>

    <%= yield %>
    <script>
      (function() {
        function updateBodyPadding() {
          try {
            var nav = document.querySelector('.navbar.fixed-top');
            var padding = nav ? nav.offsetHeight : 0;
            document.body.style.paddingTop = padding + 'px';
          } catch (e) {
            // noop
          }
        }

        // Run on initial loads (Turbo or non-Turbo)
        document.addEventListener('DOMContentLoaded', updateBodyPadding);
        document.addEventListener('turbo:load', updateBodyPadding);
        // Adjust on resize
        window.addEventListener('resize', updateBodyPadding);

        // Also listen for Bootstrap navbar collapse events when available
        document.addEventListener('shown.bs.collapse', updateBodyPadding);
        document.addEventListener('hidden.bs.collapse', updateBodyPadding);
      })();
    </script>
  </body>
</html>
