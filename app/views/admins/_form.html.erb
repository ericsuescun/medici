<%= form_with(model: admin) do |f| %>
  <% if admin.errors.any? %>
    <div style="color: red">
      <h2><%= t("admins.errors_header", count: admin.errors.count) %></h2>
      <ul>
        <% admin.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="mb-3">
    <legend><%= t("admins.form_user_data") %></legend>
    <div class="row">
      <div class="col-md-6">
        <%= f.fields_for :user do |u| %>
          <div class="mb-2">
            <%= u.label :firstname, t("admins.firstname") %>
            <%= u.text_field :firstname, class: 'form-control' %>
          </div>
          <div class="mb-2">
            <%= u.label :lastname, t("admins.lastname") %>
            <%= u.text_field :lastname, class: 'form-control' %>
          </div>
          <div class="mb-2">
            <%= u.label :email %>
            <%= u.email_field :email, class: 'form-control' %>
          </div>
          <% if admin.new_record? || admin.user&.encrypted_password.blank? %>
            <div class="mb-2">
              <%= u.label :password %>
              <%= u.password_field :password, class: 'form-control' %>
            </div>
            <div class="mb-2">
              <%= u.label :password_confirmation %>
              <%= u.password_field :password_confirmation, class: 'form-control' %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("admins.form_profile") %></legend>
    <div class="row">
      <div class="col-md-6">
        <div class="mb-2">
          <%= f.label :title, t("admins.title") %>
          <%= f.text_field :title, class: 'form-control' %>
        </div>
        <div class="mb-2">
          <%= f.label :contact_number, t("admins.contact_number") %>
          <%= f.text_field :contact_number, class: 'form-control' %>
        </div>
        <div class="mb-2">
          <%= f.label :contact_address, t("admins.contact_address") %>
          <%= f.text_field :contact_address, class: 'form-control' %>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="mt-3">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>
