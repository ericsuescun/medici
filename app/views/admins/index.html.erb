<div class="container">
  <p style="color: green"><%= notice %></p>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Admins</h1>
    <%= link_to "New admin", new_admin_path, class: "btn btn-primary" %>
  </div>

  <table class="table table-striped">
    <thead>
    <tr>
      <th>Nombre</th>
      <th>Email</th>
      <th>Telefono</th>
      <th>Direccion</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @admins.each do |a| %>
      <tr>
        <td><%= link_to a.fullname, admin_path(a) %></td>
        <td><%= a.email %></td>
        <td><%= a.contact_number %></td>
        <td><%= a.contact_address %></td>
        <td>
          <%= link_to 'Edit', edit_admin_path(a), class: 'btn btn-sm btn-outline-secondary' %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
