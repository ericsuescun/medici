<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @admin.fullname %></h3>
  </div>
  <div class="card-body">
    <p><strong><%= t("admins.email") %>:</strong> <%= @admin.email %></p>
    <p><strong><%= t("admins.contact_number") %>:</strong> <%= @admin.contact_number %></p>
    <p><strong><%= t("admins.contact_address") %>:</strong> <%= @admin.contact_address %></p>
    <p><strong><%= t("admins.title") %>:</strong> <%= @admin.title %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to t("admins.show_edit"), edit_admin_path(@admin) %> |
  <%= link_to t("admins.show_back"), admins_path %>
  <%= button_to t("admins.show_destroy"), @admin, method: :delete, class: "btn btn-danger ms-2" %>
</div>
