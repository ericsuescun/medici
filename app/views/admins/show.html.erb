<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @admin.fullname %></h3>
  </div>
  <div class="card-body">
    <p><strong>Email:</strong> <%= @admin.email %></p>
    <p><strong>Telefono:</strong> <%= @admin.contact_number %></p>
    <p><strong>Direccion:</strong> <%= @admin.contact_address %></p>
    <p><strong>Titulo:</strong> <%= @admin.title %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to "Edit this admin", edit_admin_path(@admin) %> |
  <%= link_to "Back to admins", admins_path %>
  <%= button_to "Destroy this admin", @admin, method: :delete, class: "btn btn-danger ms-2" %>
</div>
