<%= form_with(model: patient) do |form| %>
  <% if patient.errors.any? %>
    <div style="color: red">
      <h2><%= t("patients.errors_header", count: patient.errors.count) %></h2>

      <ul>
        <% patient.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if patient.persisted? && policy(patient).show_state? %>
    <div class="alert alert-info">
      <%= t("patients.current_state") %> <span class="badge bg-secondary"><%= patient.state %></span>
    </div>
  <% end %>

  <div>
    <%= form.label :firstname, style: "display: block" %>
    <%= form.text_field :firstname, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :lastname, style: "display: block" %>
    <%= form.text_field :lastname, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :dob, style: "display: block" %>
    <%= form.date_field :dob, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :contact_number, style: "display: block" %>
    <%= form.text_field :contact_number, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :contact_address, style: "display: block" %>
    <%= form.text_field :contact_address, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :email, style: "display: block" %>
    <%= form.text_field :email, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :country, style: "display: block" %>
    <%= form.select :country, country_options_for_select(@patient.country.presence), { include_blank: true }, class: "form-select mb-3" %>
  </div>

  <div>
    <%= form.label :id_type, style: "display: block" %>
    <%= form.select :id_type, options_from_collection_for_select(IdType.by_country((@patient.country.presence || 'CO')).active, :code, :name, @patient.id_type), { include_blank: true }, class: "form-select mb-3" %>
  </div>

  <div>
    <%= form.label :id_number, style: "display: block" %>
    <%= form.text_field :id_number, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :illness_description, style: "display: block" %>
    <%= form.text_area :illness_description, class: "form-control mb-3" %>
  </div>

  <%# Which study this patient is being considered for. Only the studies the
      current user may enrol into are offered — their own centre's for a trial
      centre rep, all of them for an admin. PatientsController#create re-checks
      it, because a select is not a security boundary. %>
  <div>
    <%= form.label :study_id, Study.model_name.human, style: "display: block" %>
    <%= form.collection_select :study_id, enrollable_studies, :id,
                               ->(s) { s.display_title },
                               { include_blank: true }, class: "form-select mb-3" %>
  </div>

  <div>
    <%= form.submit t("common.save"), class: 'btn btn-primary btn-block' %>
  </div>
<% end %>
