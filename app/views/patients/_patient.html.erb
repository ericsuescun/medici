<div id="<%= dom_id patient %>" class="card patient-card">
  <div class="card-header">
    <h5 class="card-title"><%= patient.firstname %> <%= patient.lastname %></h5>
  </div>
  <div class="card-body">
    <% if policy(patient).show_state? %>
      <p>
        <strong><%= Patient.human_attribute_name(:state) %>:</strong>
        <%= patient.state %>
      </p>

      <div class="mb-3">
        <div class="btn-group" role="group">
          <% if policy(patient).assess? %>
            <%= button_to t("patients.assess"), transition_patient_path(patient, event: 'assess'), method: :post, class: 'btn btn-sm btn-outline-primary', form: { data: { turbo: true } } %>
          <% end %>
          <% if policy(patient).accept? %>
            <%= button_to t("patients.accept"), transition_patient_path(patient, event: 'accept'), method: :post, class: 'btn btn-sm btn-outline-success', form: { data: { turbo: true } } %>
          <% end %>
          <% if policy(patient).discard? %>
            <%= button_to t("patients.discard"), transition_patient_path(patient, event: 'discard'), method: :post, class: 'btn btn-sm btn-outline-warning', form: { data: { turbo: true } } %>
          <% end %>
          <% if policy(patient).reject? %>
            <%= button_to t("patients.reject"), transition_patient_path(patient, event: 'reject'), method: :post, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo: true } } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <p>
      <strong><%= Patient.human_attribute_name(:country) %>:</strong>
      <%= patient.country %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:id_type) %>:</strong>
      <%= patient.id_type %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:id_number) %>:</strong>
      <%= patient.id_number %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:illness_description) %>:</strong>
      <%= patient.illness_description %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:dob) %>:</strong>
      <%= patient.dob %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:contact_number) %>:</strong>
      <%= patient.contact_number %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:contact_address) %>:</strong>
      <%= patient.contact_address %>
    </p>

    <p>
      <strong><%= Patient.human_attribute_name(:email) %>:</strong>
      <%= patient.email %>
    </p>
  </div>
</div>
