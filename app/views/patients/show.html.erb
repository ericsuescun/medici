<p style="color: green"><%= notice %></p>

<%= render @patient %>

<% if policy(@patient).show? %>
  <div class="mt-3">
    <%= link_to t("patient_briefings.open_briefing"), patient_briefing_path(@patient), class: "btn btn-primary" %>
  </div>
<% end %>

<% study = @patient.study %>
<% if study&.criteria_profile && policy(@patient).update? %>
  <div class="mt-3">
    <h5><%= t("patients.eligibility_assessment") %></h5>
    <div class="d-flex flex-column align-items-start gap-2">
      <%= link_to t("patients.assess_criteria", title: study.public_title),
                  patient_criteria_assessment_path(@patient, criteria_profile_id: study.criteria_profile.id),
                  class: "btn btn-sm btn-outline-primary" %>
    </div>
  </div>
<% end %>

<% if policy(@patient).show? %>
  <div class="mt-3 d-flex flex-column align-items-start gap-2">
    <div>
      <h5><%= t("soap_notes.index_title") %></h5>
      <%= link_to t("soap_notes.view_notes", count: @patient.soap_notes.size),
                  patient_soap_notes_path(@patient),
                  class: "btn btn-sm btn-outline-secondary" %>
    </div>
    <div>
      <h5><%= t("complementary_informations.index_title") %></h5>
      <%= link_to t("complementary_informations.view_link"),
                  patient_complementary_information_path(@patient),
                  class: "btn btn-sm btn-outline-secondary" %>
    </div>
  </div>
<% end %>

<div>
  <%= link_to t("common.edit"), edit_patient_path(@patient) %> |
  <%= link_to t("patients.back_to_index"), patients_path %>
  <% if current_user&.admin? %>
    | <%= link_to t("patients.change_control"), change_control_path("Patient", @patient.id) %>
  <% end %>

  <%= button_to t("common.destroy"), @patient, method: :delete %>
</div>
