<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% content_for :title, "Patients" %>

  <h1 class="mb-4">Pacientes</h1>

  <div class="mb-4">
    <%= link_to "Retornar a Vitalia", static_pages_medici_home_path %> |
    <%= link_to "Nuevo paciente", new_patient_path %>
  </div>

  <div id="patients">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>País</th>
          <th>Tipo ID</th>
          <th>Número ID</th>
          <th>Enfermedad</th>
          <th>Estudios</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @patients.each do |patient| %>
          <tr id="<%= dom_id(patient) %>">
            <td><strong><%= link_to "#{patient.firstname} #{patient.lastname}", patient %></strong></td>
            <td><%= patient.country %></td>
            <td><%= patient.id_type %></td>
            <td><%= patient.id_number %></td>
            <td class="text-truncate" style="max-width: 280px;"><%= patient.illness_description %></td>
            <td>
              <% if patient.user && patient.user.studies.any? %>
                <% patient.user.studies.each do |study| %>
                  <%= link_to (study.short_title.presence || study.public_title || "Ver estudio"), study, class: "badge bg-info text-white me-1" %>
                <% end %>
              <% end %>
            </td>
            <td>
              <% if policy(patient).show_state? %>
                <span class="badge bg-secondary"><%= patient.state %></span>
              <% end %>
            </td>
            <td>
              <%# Transition buttons shown only when permitted by policy and AASM %>
              <div class="btn-group" role="group">
                <% if policy(patient).assess? %>
                  <%= button_to 'Evaluar', transition_patient_path(patient, event: 'assess'), method: :post, class: 'btn btn-sm btn-outline-primary', form: { data: { turbo: true } } %>
                <% end %>
                <% if policy(patient).accept? %>
                  <%= button_to 'Aceptar', transition_patient_path(patient, event: 'accept'), method: :post, class: 'btn btn-sm btn-outline-success', form: { data: { turbo: true } } %>
                <% end %>
                <% if policy(patient).discard? %>
                  <%= button_to 'Descartar', transition_patient_path(patient, event: 'discard'), method: :post, class: 'btn btn-sm btn-outline-warning', form: { data: { turbo: true } } %>
                <% end %>
                <% if policy(patient).reject? %>
                  <%= button_to 'Rechazar', transition_patient_path(patient, event: 'reject'), method: :post, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo: true } } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%= link_to "Retornar a Vitalia", static_pages_medici_home_path %> |
    <%= link_to "Nuevo paciente", new_patient_path %>
  </div>
</div>
