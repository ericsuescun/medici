<%# THE RECRUITMENT PIPELINE: interested + candidate only.

    Enrolled patients live at #participants — they are a result to report, not a
    queue to work, and leaving them here meant the page a rep opens all day grew
    by one permanently-irrelevant row per success. %>
<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <% content_for :title, t("patients.index_title") %>

  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1"><%= t("patients.recruitment_title") %></h1>
      <p class="text-muted mb-0"><%= t("patients.recruitment_subtitle") %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to t("patients.participants_link"), participants_patients_path, class: "btn btn-sm btn-outline-success" %>
      <%= link_to t("patients.new_patient"), new_patient_path, class: "btn btn-sm btn-primary" %>
    </div>
  </div>

  <%= render "patients/filters",
             filter: @filter,
             url: patients_path,
             states: Patient::RECRUITING_STATES,
             recommendations: PatientsController::RECOMMENDATIONS,
             recommendation: @recommendation,
             leads_toggle: true %>

  <%= render "patients/grouped_by_study",
             patients_by_study: @patients_by_study,
             declaration_counts: @declaration_counts,
             empty_message: (@filter.any? || @recommendation.present?) ? t("patients.no_matches") : t("patients.no_patients") %>

  <div class="mt-4">
    <%= link_to t("patients.back_to_home"), static_pages_medici_home_path %> |
    <%= link_to t("patients.new_patient"), new_patient_path %>
  </div>
</div>
