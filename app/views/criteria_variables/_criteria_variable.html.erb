<div id="<%= dom_id criteria_variable %>" class="card">
  <div class="card-header">
    <h3 class="card-title"><%= criteria_variable.name %></h3>
  </div>
  <div class="card-body">
    <p>
      <strong>Descripción:</strong>
      <%= criteria_variable.description.presence || '-' %>
    </p>
    <p>
      <strong>Tipo de variable:</strong>
      <%= criteria_variable.value_type %>
    </p>
    <p>
      <strong>Tipo de regla:</strong>
      <% if criteria_variable.variable_type == "inclusion" %>
        <span class="badge bg-success">inclusion</span>
      <% else %>
        <span class="badge bg-danger">exclusion</span>
      <% end %>
    </p>
    <p>
      <strong>Tipo de comparación:</strong>
      <%= criteria_variable.comparison_type %>
    </p>
    <p>
      <strong>Valor referencia 1:</strong>
      <%= criteria_variable.reference_value_1 %>
    </p>
    <p>
      <strong>Valor referencia 2:</strong>
      <%= criteria_variable.reference_value_2 %>
    </p>

    <p>
      <strong>Escala cualitativa:</strong>
      <%= (criteria_variable.qualitative_scale || []).join(', ').presence || '-' %>
    </p>
    <p>
      <strong>Valor cualitativo:</strong>
      <%= criteria_variable.qualitative_value.presence || '-' %>
    </p>

    <p>
      <strong>Condiciones:</strong>
      <%= criteria_variable.conditions.presence || '-' %>
    </p>

    <p>
      <strong>Habilitada:</strong>
      <%= criteria_variable.enabled? ? 'Sí' : 'No' %>
    </p>
    <p>
      <strong>Visible:</strong>
      <%= criteria_variable.shown? ? 'Sí' : 'No' %>
    </p>
  </div>
</div>
