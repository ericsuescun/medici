<div id="<%= dom_id criteria_variable %>" class="card">
  <div class="card-header">
    <h3 class="card-title"><%= criteria_variable.name %></h3>
  </div>
  <div class="card-body">
    <p>
      <strong><%= t("criteria_variables.description") %>:</strong>
      <%= criteria_variable.description.presence || '-' %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:value_type) %>:</strong>
      <%= criteria_variable.value_type %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:variable_type) %>:</strong>
      <% if criteria_variable.variable_type == "inclusion" %>
        <span class="badge bg-success"><%= t_enum(criteria_variable, :variable_type) %></span>
      <% else %>
        <span class="badge bg-danger"><%= t_enum(criteria_variable, :variable_type) %></span>
      <% end %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:comparison_type) %>:</strong>
      <%= criteria_variable.comparison_type %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:reference_value_1) %>:</strong>
      <%= criteria_variable.reference_value_1 %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:reference_value_2) %>:</strong>
      <%= criteria_variable.reference_value_2 %>
    </p>

    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:qualitative_scale) %>:</strong>
      <%= (criteria_variable.qualitative_scale || []).join(', ').presence || '-' %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:qualitative_value) %>:</strong>
      <%= criteria_variable.qualitative_value.presence || '-' %>
    </p>

    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:conditions) %>:</strong>
      <%= criteria_variable.conditions.presence || '-' %>
    </p>

    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:enabled) %>:</strong>
      <%= criteria_variable.enabled? ? t("common.yes") : t("common.no") %>
    </p>
    <p>
      <strong><%= CriteriaVariable.human_attribute_name(:shown) %>:</strong>
      <%= criteria_variable.shown? ? t("common.yes") : t("common.no") %>
    </p>
  </div>
</div>
