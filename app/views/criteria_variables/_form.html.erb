<%= form_with(model: [@criteria_profile, @criteria_variable], class: "row g-3") do |form| %>
  <% if @criteria_variable.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@criteria_variable.errors.count, "error") %> impidieron guardar la variable:</h4>
      <ul>
        <% @criteria_variable.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="col-md-3">
    <%= form.label :criteria_order, "Orden dentro del grupo" %>
    <%= form.number_field :criteria_order, class: "form-control", min: 0, step: 1 %>
    <div class="form-text">Sugerido automáticamente según el grupo (inclusión/exclusión). Puede cambiarlo.</div>
  </div>

  <div class="col-md-6">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="col-12">
    <%= form.label :description, "Descripción" %>
    <%= form.text_area :description, class: "form-control", rows: 3 %>
  </div>

  <div class="col-md-4">
    <%= form.label :value_type, "Tipo de variable" %>
    <%= form.select :value_type, CriteriaVariable.value_types.keys.map { |k| [k.humanize, k] }, {}, class: "form-select", required: true %>
  </div>

  <div class="col-md-4">
    <%= form.label :variable_type, "Tipo de regla" %>
    <%= form.select :variable_type, CriteriaVariable.variable_types.keys.map { |k| [k.humanize, k] }, {}, class: "form-select", required: true %>
  </div>

  <div class="col-md-4">
    <%= form.label :comparison_type, "Tipo de comparación" %>
    <%= form.select :comparison_type, CriteriaVariable.comparison_types.keys.map { |k| [k.humanize, k] }, {}, class: "form-select", required: true %>
  </div>

  <div class="col-md-4">
    <%= form.label :reference_value_1, "Valor de referencia 1" %>
    <%= form.number_field :reference_value_1, step: :any, class: "form-control" %>
  </div>

  <div class="col-md-4">
    <%= form.label :reference_value_2, "Valor de referencia 2" %>
    <%= form.number_field :reference_value_2, step: :any, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= form.label :qualitative_scale, "Escala cualitativa (separada por comas)" %>
    <%= form.text_field :qualitative_scale, value: @criteria_variable.qualitative_scale&.join(', '), class: "form-control", placeholder: "Alto, Medio, Bajo" %>
    <div class="form-text">Ingrese los valores cualitativos separados por comas.</div>
  </div>

  <div class="col-md-6">
    <%= form.label :qualitative_value, "Valor cualitativo" %>
    <%= form.text_field :qualitative_value, class: "form-control", placeholder: "Medio" %>
  </div>

  <div class="col-12">
    <%= form.label :conditions, "Condiciones (texto)" %>
    <%= form.text_area :conditions, class: "form-control", rows: 3 %>
  </div>

  <div class="col-md-3 form-check">
    <%= form.check_box :enabled, class: "form-check-input", id: "criteria_variable_enabled" %>
    <%= form.label :enabled, "Habilitada", class: "form-check-label" %>
  </div>

  <div class="col-md-3 form-check">
    <%= form.check_box :shown, class: "form-check-input", id: "criteria_variable_shown" %>
    <%= form.label :shown, "Visible", class: "form-check-label" %>
  </div>

  <div class="col-12">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
