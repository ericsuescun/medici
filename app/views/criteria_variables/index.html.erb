<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p class="mt-2" style="color: green"><%= notice %></p>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Variables del Perfil: <%= @criteria_profile.name %></h1>
        <%= link_to 'Nueva Variable', new_criteria_profile_criteria_variable_path(@criteria_profile), class: 'btn btn-primary' %>
      </div>

      <% if @criteria_variables.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Comparación</th>
            <th>Ref 1</th>
            <th>Ref 2</th>
            <th></th>
          </tr>
          </thead>
          <tbody>
          <% @criteria_variables.each do |variable| %>
            <tr>
              <td><%= link_to variable.name, [@criteria_profile, variable] %></td>
              <td><%= variable.variable_type %></td>
              <td><%= variable.comparison_type %></td>
              <td><%= variable.reference_value_1 %></td>
              <td><%= variable.reference_value_2 %></td>
              <td>
                <%= link_to 'Editar', edit_criteria_profile_criteria_variable_path(@criteria_profile, variable) %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="alert alert-info">Aún no hay variables para este perfil. Crea la primera.</div>
      <% end %>

      <div class="mt-3">
        <%= link_to 'Volver al Perfil', criteria_profile_path(@criteria_profile) %>
      </div>
    </div>
  </div>
</div>
