<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p class="mt-2" style="color: green"><%= notice %></p>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><%= t("criteria_variables.index.title", name: @criteria_profile.name) %></h1>
        <%= link_to t("criteria_variables.new_variable"), new_criteria_profile_criteria_variable_path(@criteria_profile), class: 'btn btn-primary' %>
      </div>

      <% if @criteria_variables.any? %>
        <table class="table table-striped">
          <thead>
          <tr>
            <th><%= CriteriaVariable.human_attribute_name(:criteria_order) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:name) %></th>
            <th><%= t("criteria_variables.description") %></th>
            <th><%= CriteriaVariable.human_attribute_name(:value_type) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:variable_type) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:criteria_category) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:patient_prompt) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:comparison_type) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:reference_value_1) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:reference_value_2) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:conditions) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:qualitative_scale) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:qualitative_value) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:enabled) %></th>
            <th><%= CriteriaVariable.human_attribute_name(:shown) %></th>
            <th></th>
          </tr>
          </thead>
          <tbody>
          <% @criteria_variables.each do |variable| %>
            <tr>
              <td><%= variable.criteria_order.present? ? variable.criteria_order : '-' %></td>
              <td><%= link_to variable.name, [@criteria_profile, variable] %></td>
              <td><%= variable.description %></td>
              <td><%= variable.value_type %></td>
              <td>
                <%= variable_type_badge(variable) %>
              </td>
              <td>
                <%= criteria_category_badge(variable) %>
              </td>
              <%# The patient-facing question. Its PRESENCE is what makes the rule
                  askable at all (CriteriaVariable#askable_to_patient?), so a blank
                  cell means the public questionnaire never asks this one. %>
              <td style="min-width: 14rem">
                <% if variable.patient_prompt.present? %>
                  <%= variable.patient_prompt %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td><%= variable.comparison_type %></td>
              <td><%= variable.reference_value_1 %></td>
              <td><%= variable.reference_value_2 %></td>
              <td><%= variable.conditions.presence || '-' %></td>
              <td><%= (variable.qualitative_scale || []).join(', ') %></td>
              <td><%= variable.qualitative_value %></td>
              <td>
                <%= boolean_checkbox(variable.enabled?, label: CriteriaVariable.human_attribute_name(:enabled)) %>
              </td>
              <td>
                <%= boolean_checkbox(variable.shown?, label: CriteriaVariable.human_attribute_name(:shown)) %>
              </td>
              <td>
                <%= link_to t("common.edit"), edit_criteria_profile_criteria_variable_path(@criteria_profile, variable) %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="alert alert-info"><%= t("criteria_variables.index.empty") %></div>
      <% end %>

      <div class="mt-3">
        <%= link_to t("criteria_variables.back_to_profile"), criteria_profile_path(@criteria_profile) %>
      </div>
    </div>
  </div>
</div>
