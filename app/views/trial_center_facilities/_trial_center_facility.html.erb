<div class="card facility-card">
  <h5 class="card-header"><%= trial_center_facility.name %></h5>
  <div class="card-body">
    <h5 class="card-title"><%= trial_center_facility.description %></h5>
    <p class="card-text">
    <p><strong><%= TrialCenterFacility.human_attribute_name(:initials) %>: </strong><%= trial_center_facility.initials %></p>
    <p><strong><%= TrialCenterFacility.human_attribute_name(:email) %>: </strong><%= trial_center_facility.email %></p>
    <p><strong><%= TrialCenterFacility.human_attribute_name(:contact_number) %>: </strong><%= trial_center_facility.contact_number %></p>
    <p><strong><%= TrialCenterFacility.human_attribute_name(:contact_address) %>: </strong><%= trial_center_facility.contact_address %></p>
    <p><strong><%= TrialCenterFacility.human_attribute_name(:url) %>: </strong><%= link_to trial_center_facility.url %></p>
    <p><strong><%= t("trial_center_facilities.cities_label") %>: </strong><%= trial_center_facility.cities.pluck(:name).join(', ') %></p>
    <p><strong><%= t("trial_center_facilities.studies_label") %>: </strong><% trial_center_facility.studies.each do |study| %>
        <%= link_to "#{study.short_title.present? ? study.short_title : study.public_title}", study %>
      <% end %>
    </p>
    <%= link_to t("trial_center_facilities.add_branch"), new_trial_center_facility_trial_center_branch_path(trial_center_facility) %>
    <div class="row mt-3">
      <% trial_center_facility.trial_center_branches.each do |tcb| %>
        <div class="col-4">
          <div class="card branch-card mb-3">
            <% branch_city = tcb.cities.pluck(:name).first %>
            <h5 class="card-header"><%= link_to tcb.name, tcb %><% if branch_city.present? %> (<%= branch_city %>)<% end %></h5>
            <div class="card-body">
              <h5 class="card-title"><%= tcb.description %></h5>
              <p class="card-text">
              <p><strong><%= TrialCenterFacility.human_attribute_name(:initials) %>: </strong><%= trial_center_facility.initials %></p>
              <p><strong><%= TrialCenterFacility.human_attribute_name(:email) %>: </strong><%= trial_center_facility.email %></p>
              <p><strong><%= TrialCenterFacility.human_attribute_name(:contact_number) %>: </strong><%= trial_center_facility.contact_number %></p>
              <p><strong><%= TrialCenterFacility.human_attribute_name(:contact_address) %>: </strong><%= trial_center_facility.contact_address %></p>
              <p><strong><%= TrialCenterFacility.human_attribute_name(:url) %>: </strong><%= link_to trial_center_facility.url %></p>
              <p><strong><%= t("trial_center_facilities.studies_label") %>: </strong><% tcb.studies.each do |study| %>
                  <%= link_to "#{study.short_title.present? ? study.short_title : study.public_title}", study %>
                <% end %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
