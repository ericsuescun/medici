<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @trial_center_branch_rep.fullname %></h3>
  </div>
  <div class="card-body">
    <p><strong>Email:</strong> <%= @trial_center_branch_rep.email %></p>
    <p><strong>Telefono:</strong> <%= @trial_center_branch_rep.contact_number %></p>
    <p><strong>Direccion:</strong> <%= @trial_center_branch_rep.contact_address %></p>
    <p><strong>Titulo:</strong> <%= @trial_center_branch_rep.title %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to "Editar", edit_trial_center_branch_rep_path(@trial_center_branch_rep) %> |
  <%= link_to "Volver", trial_center_branch_reps_path %>
  <%= button_to "Eliminar", @trial_center_branch_rep, method: :delete, class: "btn btn-danger ms-2" %>
</div>
