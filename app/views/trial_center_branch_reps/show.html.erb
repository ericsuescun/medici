<p style="color: green"><%= notice %></p>

<div class="card">
  <div class="card-header">
    <h3><%= @trial_center_branch_rep.fullname %></h3>
  </div>
  <div class="card-body">
    <p><strong><%= t("trial_center_branch_reps.email") %>:</strong> <%= @trial_center_branch_rep.email %></p>
    <p><strong><%= TrialCenterBranchRep.human_attribute_name(:contact_number) %>:</strong> <%= @trial_center_branch_rep.contact_number %></p>
    <p><strong><%= TrialCenterBranchRep.human_attribute_name(:contact_address) %>:</strong> <%= @trial_center_branch_rep.contact_address %></p>
    <p><strong><%= TrialCenterBranchRep.human_attribute_name(:title) %>:</strong> <%= @trial_center_branch_rep.title %></p>
  </div>
</div>

<div class="mt-3">
  <%= link_to t("trial_center_branch_reps.show_edit"), edit_trial_center_branch_rep_path(@trial_center_branch_rep) %> |
  <%= link_to t("trial_center_branch_reps.show_back"), trial_center_branch_reps_path %>
  <%= button_to t("trial_center_branch_reps.show_destroy"), @trial_center_branch_rep, method: :delete, class: "btn btn-danger ms-2" %>
</div>
