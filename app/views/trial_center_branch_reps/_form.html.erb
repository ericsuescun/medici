<%= form_with(model: trial_center_branch_rep) do |f| %>
  <% if trial_center_branch_rep.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(trial_center_branch_rep.errors.count, "error") %> prohibited this representative from being saved:</h2>
      <ul>
        <% trial_center_branch_rep.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="mb-3">
    <legend>Datos del Usuario</legend>
    <div class="row">
      <div class="col-md-6">
        <%= f.fields_for :user do |u| %>
          <div class="mb-2">
            <%= u.label :firstname, 'Nombre' %>
            <%= u.text_field :firstname, class: 'form-control' %>
          </div>
          <div class="mb-2">
            <%= u.label :lastname, 'Apellido' %>
            <%= u.text_field :lastname, class: 'form-control' %>
          </div>
          <div class="mb-2">
            <%= u.label :email %>
            <%= u.email_field :email, class: 'form-control' %>
          </div>
          <% if trial_center_branch_rep.new_record? || trial_center_branch_rep.user&.encrypted_password.blank? %>
            <div class="mb-2">
              <%= u.label :password %>
              <%= u.password_field :password, class: 'form-control' %>
            </div>
            <div class="mb-2">
              <%= u.label :password_confirmation %>
              <%= u.password_field :password_confirmation, class: 'form-control' %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </fieldset>

  <% if trial_center_branch_rep.trial_center_branch_id.present? %>
    <%= f.hidden_field :trial_center_branch_id %>
  <% end %>

  <fieldset>
    <legend>Perfil de Representante de Sede</legend>
    <div class="row">
      <div class="col-md-6">
        <div class="mb-2">
          <%= f.label :title, 'Titulo' %>
          <%= f.text_field :title, class: 'form-control' %>
        </div>
        <div class="mb-2">
          <%= f.label :contact_number, 'Telefono' %>
          <%= f.text_field :contact_number, class: 'form-control' %>
        </div>
        <div class="mb-2">
          <%= f.label :contact_address, 'Direccion' %>
          <%= f.text_field :contact_address, class: 'form-control' %>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="mt-3">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>
