<p style="color: green"><%= notice %></p>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Representantes de Sedes</h1>
  <%= link_to "Nuevo representante de sede", new_trial_center_branch_rep_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Email</th>
      <th>Telefono</th>
      <th>Direccion</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @trial_center_branch_reps.each do |r| %>
      <tr>
        <td><%= link_to r.fullname, trial_center_branch_rep_path(r) %></td>
        <td><%= r.email %></td>
        <td><%= r.contact_number %></td>
        <td><%= r.contact_address %></td>
        <td>
          <%= link_to 'Edit', edit_trial_center_branch_rep_path(r), class: 'btn btn-sm btn-outline-secondary' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
