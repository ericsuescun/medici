<div class="container">
  <p style="color: green"><%= notice %></p>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= t("trial_center_branch_reps.index_title") %></h1>
    <%= link_to t("trial_center_branch_reps.new"), new_trial_center_branch_rep_path, class: "btn btn-primary" %>
  </div>

  <table class="table table-striped">
    <thead>
    <tr>
      <th><%= t("trial_center_branch_reps.table_name") %></th>
      <th><%= t("trial_center_branch_reps.email") %></th>
      <th><%= TrialCenterBranchRep.human_attribute_name(:contact_number) %></th>
      <th><%= TrialCenterBranchRep.human_attribute_name(:contact_address) %></th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @trial_center_branch_reps.each do |r| %>
      <tr>
        <td><%= link_to r.fullname, trial_center_branch_rep_path(r) %></td>
        <td><%= r.email %></td>
        <td><%= r.contact_number %></td>
        <td><%= r.contact_address %></td>
        <td>
          <%= link_to t("common.edit"), edit_trial_center_branch_rep_path(r), class: 'btn btn-sm btn-outline-secondary' %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
