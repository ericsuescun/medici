<div class="container py-4">
  <div class="row">
    <div class="col-12">
      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>

      <% content_for :title, "Sponsors" %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Patrocinadores</h1>
        <div>
          <%= link_to "Retornar a Vitalia", static_pages_medici_home_path %> |
          <%= link_to "Nuevo Patrocinador", new_sponsor_path%>
        </div>
      </div>

      <div id="sponsors">
        <div class="card mb-4">
          <div class="card-body">
            <div class="table">
              <table class="table table-striped">
                <thead>
                <tr>
                  <th>Nombre</th>
                  <th># Estudios</th>
                  <th>Iniciales</th>
                  <th>Sponsor type</th>
                </tr>
                </thead>
                <tbody>
                <% @sponsors.each do |sponsor| %>
                  <tr>
                    <td><%= link_to sponsor.name, sponsor %></td>
                    <td><span class="badge bg-primary"><%= sponsor.studies.count %></span></td>
                    <td><%= sponsor.capitals %></td>
                    <td><%= t_enum(sponsor, :sponsor_type) %></td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <div class="d-flex justify-content-between align-items-center">
          <%= will_paginate @sponsors, :renderer => WillPaginate::ActionView::Bootstrap4LinkRenderer %>
          <div>
            <%= link_to "Retornar a Vitalia", static_pages_medici_home_path %> |
            <%= link_to "Nuevo Patrocinador", new_sponsor_path%>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
