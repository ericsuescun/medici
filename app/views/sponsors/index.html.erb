<div class="container">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <% content_for :title, "Sponsors" %>
      <h1>Patrocinadores</h1>

      <div id="sponsors">
        <table class="table table-striped">
          <thead>
          <tr>
            <th>Nombre</th>
            <th># Estudios</th>
            <th>Iniciales</th>
            <th>Sponsor type</th>
          </tr>
          </thead>
          <tbody>
          <% @sponsors.each do |sponsor| %>
            <tr>
              <td><%= link_to sponsor.name, sponsor %></td>
              <td><%= sponsor.studies.count %></td>
              <td><%= sponsor.capitals %></td>
              <td><%= sponsor.sponsor_type %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
        <%= will_paginate @sponsors, :renderer => WillPaginate::ActionView::Bootstrap4LinkRenderer %>
        <%= link_to "Retornar a Be My Trial", static_pages_medici_home_path %> |
        <%= link_to "Nuevo Patrocinador", new_sponsor_path %>
      </div>
    </div>
  </div>
</div>
