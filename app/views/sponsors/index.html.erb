<div class="container py-4">
  <div class="row">
    <div class="col-12">
      <% if notice.present? %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>

      <% content_for :title, "Sponsors" %>
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Patrocinadores</h1>
        <div>
          <%= link_to "Retornar a Be My Trial", static_pages_medici_home_path, class: "btn btn-outline-primary me-2" %>
          <%= link_to "Nuevo Patrocinador", new_sponsor_path, class: "btn btn-success" %>
        </div>
      </div>

      <div id="sponsors">
        <div class="card health-card shadow-sm mb-4">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped mb-0">
                <thead>
                <tr>
                  <th>Nombre</th>
                  <th># Estudios</th>
                  <th>Iniciales</th>
                  <th>Sponsor type</th>
                  <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                <% @sponsors.each do |sponsor| %>
                  <tr>
                    <td><%= link_to sponsor.name, sponsor %></td>
                    <td><span class="badge bg-primary"><%= sponsor.studies.count %></span></td>
                    <td><%= sponsor.capitals %></td>
                    <td><span class="badge bg-info text-dark"><%= sponsor.sponsor_type %></span></td>
                    <td>
                      <%= link_to "Ver", sponsor, class: "btn btn-sm btn-primary" %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <div class="d-flex justify-content-between align-items-center">
          <%= will_paginate @sponsors, :renderer => WillPaginate::ActionView::Bootstrap4LinkRenderer %>
          <div>
            <%= link_to "Retornar a Be My Trial", static_pages_medici_home_path, class: "btn btn-outline-primary me-2" %>
            <%= link_to "Nuevo Patrocinador", new_sponsor_path, class: "btn btn-success" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
