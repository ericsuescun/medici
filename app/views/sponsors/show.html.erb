<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <%= render @sponsor %>

      <div>
        <%= link_to "Editar", edit_sponsor_path(@sponsor) %> |
        <%= link_to "Retornar a Patrocinadores", sponsors_path %>

        <%= button_to "Borrar", @sponsor, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <hr/>
      <div class="mt-3">
        <h4>Representantes</h4>
        <% reps = @sponsor.sponsor_reps.includes(:user) %>
        <% if reps.any? %>
          <ul>
            <% reps.each do |r| %>
              <li>
                <%= r.fullname.presence || r.email %>
                <%= button_to 'Desasociar', remove_rep_sponsor_path(@sponsor, rep_id: r.id), method: :delete, class: 'btn btn-sm btn-outline-danger ms-2' %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted">No hay representantes asociados.</p>
        <% end %>

        <% available_reps = SponsorRep.where(sponsor_id: nil).includes(:user) %>
        <% if available_reps.any? %>
          <%= form_with url: add_rep_sponsor_path(@sponsor), method: :post, class: 'row g-2 align-items-end' do |f| %>
            <div class="col-md-6">
              <label for="rep_id" class="form-label">Asociar representante existente</label>
              <%= select_tag :rep_id, options_from_collection_for_select(available_reps, :id, :fullname), include_blank: 'Seleccione un representante', class: 'form-select' %>
            </div>
            <div class="col-md-3">
              <button type="submit" class="btn btn-primary">Asociar</button>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted">No hay representantes disponibles para asociar.</p>
        <% end %>

      </div>
    </div>
  </div>
</div>
