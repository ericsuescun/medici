<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <p style="color: green"><%= notice %></p>

      <%= render @sponsor %>

      <div>
        <%= link_to t("common.edit"), edit_sponsor_path(@sponsor) %> |
        <%= link_to t("sponsors.back_to_index"), sponsors_path %>

        <%= button_to t("common.delete"), @sponsor, method: :delete, class: "btn btn-primary btn-block mt-3 mb-3" %>
      </div>

      <hr/>
      <div class="mt-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h4 class="mb-0"><%= t("sponsors.representatives") %></h4>
          <% if policy(SponsorRep).new? %>
            <%= link_to t("sponsors.new_representative"), new_sponsor_rep_path(sponsor_id: @sponsor.id), class: "btn btn-sm btn-primary" %>
          <% end %>
        </div>
        <% reps = @sponsor.sponsor_reps.includes(:user) %>
        <% if reps.any? %>
          <div class="table-responsive">
            <table class="table table-striped align-middle">
              <thead>
                <tr>
                  <th><%= t("sponsors.rep_name") %></th>
                  <th><%= t("sponsors.rep_email") %></th>
                  <th><%= t("sponsors.rep_title") %></th>
                  <th><%= t("sponsors.rep_phone") %></th>
                  <th class="text-end"><%= t("common.actions") %></th>
                </tr>
              </thead>
              <tbody>
                <% reps.each do |r| %>
                  <tr>
                    <td><%= link_to (r.fullname.presence || r.email), sponsor_rep_path(r) %></td>
                    <td><%= r.email %></td>
                    <td><%= r.title %></td>
                    <td><%= r.contact_number %></td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-2">
                        <% if policy(r).edit? %>
                          <%= link_to t("common.edit"), edit_sponsor_rep_path(r), class: 'btn btn-sm btn-outline-secondary' %>
                        <% end %>
                        <% if policy(r).destroy? %>
                          <%= button_to t("common.destroy"), sponsor_rep_path(r), method: :delete, class: 'btn btn-sm btn-outline-danger', form: { data: { turbo_confirm: t("sponsors.confirm_delete_representative") } } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted"><%= t("sponsors.no_representatives") %></p>
        <% end %>

      </div>
    </div>
  </div>
</div>
