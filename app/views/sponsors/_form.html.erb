<%= form_with(model: sponsor) do |form| %>
  <% if sponsor.errors.any? %>
    <div style="color: red">
      <h2><%= t("sponsors.errors_header", count: sponsor.errors.count) %></h2>

      <ul>
        <% sponsor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :initials, style: "display: block" %>
    <%= form.text_field :initials, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :shortname, style: "display: block" %>
    <%= form.text_field :shortname, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.label :sponsor_type, style: "display: block" %>
    <%= form.select(:sponsor_type,
                    [['private_type', 'private_type'], ['public_type', 'public_type'], ['mixed_type', 'mixed_type']],
                    { include_blank: true }, class: "form-select mb-3") %>
  </div>

  <div>
    <%= form.submit t("common.save"), class: 'btn btn-primary btn-block' %>
  </div>
<% end %>
