<%= render partial: 'layouts/general_navbar' if current_user.present? && !current_user.patient? %>
<%= render partial: 'layouts/patient_navbar' if current_user.present? && current_user.patient? %>

<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card health-card shadow-sm text-center">
        <div class="card-header">
          <h4 class="mb-0">Vitalia - Plataforma de Estudios Clínicos</h4>
        </div>
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <%= image_tag "/assets/logo/medici_logo.jpg", alt: "Medici Logo", class: "img-fluid rounded", style: "max-height: 187.5px;" %>
          </div>
          <h5 class="card-title mb-4">Te ayudamos a encontrar un estudio que pueda mejorar tu condición de salud</h5>
          
          <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
              <div class="stat-card">
                <div class="stat-value"><%= Sponsor.count %></div>
                <div class="stat-label">Patrocinadores</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="stat-card">
                <div class="stat-value"><%= TrialCenterFacility.count %></div>
                <div class="stat-label">Centros de Ensayos Clínicos</div>
              </div>
            </div>
          </div>
          
          <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
              <div class="stat-card">
                <div class="stat-value"><%= Study.count %></div>
                <div class="stat-label">Estudios Clínicos</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="stat-card">
                <div class="stat-value"><%= User.patients.count %></div>
                <div class="stat-label">Pacientes Registrados</div>
              </div>
            </div>
          </div>
          
          <div class="mt-4 mb-4">
            <% if user_signed_in? %>
              <%= button_to 'Salir', destroy_user_session_path, method: :delete, class: "btn btn-outline-primary btn-lg px-4" %>
            <% else %>
              <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <%= link_to 'Ingresa', new_user_session_path, class: "btn btn-primary btn-lg px-4 me-md-2" %>
                <%#= link_to 'Registrate', new_user_registration_path, class: "btn btn-outline-secondary btn-lg px-4" %>
              </div>
            <% end %>
          </div>
          
          <div class="card health-card shadow-sm mt-4">
            <div class="card-header">
              <h5 class="mb-0">Buscar Estudios por Ciudad</h5>
            </div>
            <div class="card-body">
              <%= form_with url: static_pages_search_by_city_path, method: :get, class: "row g-3 align-items-center" do |form| %>
                <div class="col-md-8 mx-auto">
                  <div class="input-group">
                    <%= form.collection_select :city_id, @cities, :id, :name, 
                        { prompt: "Selecciona una ciudad" }, 
                        { class: "form-select", required: true } %>
                    <button type="submit" class="btn btn-primary">
                      <i class="bi bi-search"></i> Buscar
                    </button>
                  </div>
                  <div class="form-text text-center mt-2">
                    Selecciona una ciudad para encontrar estudios clínicos disponibles en esa ubicación
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <% if current_user.present? %>
        <div class="d-flex justify-content-center mt-4">
          <div class="btn-group">
            <%= link_to "Ver Estudios", studies_path, class: "btn btn-success me-2" %>
            <%= link_to "Ver Patrocinadores", sponsors_path, class: "btn btn-info me-2" %>
            <%= link_to "Ver Centros", trial_center_facilities_path, class: "btn btn-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render partial: 'medici_showcase' if current_user.blank? %>