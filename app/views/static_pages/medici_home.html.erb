<%= render partial: 'layouts/general_navbar' if current_user.present? && !current_user.patient? %>
<%= render partial: 'layouts/patient_navbar' if current_user.present? && current_user.patient? %>
<div class="container">
  <div class="row">
    <div class="col-6 mx-auto">
      <div class="card text-center mt-3">
        <div class="card-body">
          <h5 class="card-title mb-3">Te ayudamos a encontrar un estudio que pueda mejorar tu condicion de salud</h5>
          <h6 class="card-subtitle mb-3 text-body-secondary">Nuestras estadisticas</h6>
          <p class="card-text">Cantidad de Patrocinadores enrolados: <%= Sponsor.count %></p>
          <p class="card-text">Cantidad de Centros de Ensayos Clinicos enrolados: <%= TrialCenterFacility.count %></p>
          <p class="card-text">Cantidad de Estudios Clinicos matriculados: <%= Study.count %></p>
          <p class="card-text">Cantidad de Pacientes registrados: <%= User.patients.count %></p>
          <% if user_signed_in? %>
            <%= button_to 'Salir', destroy_user_session_path, method: :delete, class: "card-link btn btn-outline-primary btn-block" %>
          <% else %>
            <%= link_to 'Ingresa', new_user_session_path, class: "card-link btn btn-primary btn-block" %>
            <%#= link_to 'Registrate', new_user_registration_path, class: "card-link btn btn-primary btn-block" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<%= render partial: 'medici_showcase' if current_user.blank? %>