<%#
  Operation manual. Content comes from OperationManual; see that file for why
  this page is written in Spanish rather than run through i18n.
%>
<% content_for :title, "Acerca de — Medici" %>

<%
  flag = ->(on) do
    if on
      tag.span("✓", class: "text-success fw-bold", title: "Sí", aria: { label: "Sí" })
    else
      tag.span("—", class: "text-muted", title: "No", aria: { label: "No" })
    end
  end

  status_badge = {
    done: [ "Implementado", "bg-success" ],
    partial: [ "Parcial", "bg-info text-dark" ],
    pending: [ "Pendiente", "bg-secondary" ],
    blocked: [ "Bloqueado", "bg-warning text-dark" ]
  }

  # "Volver al índice" link, reused under each section heading. Uses the
  # smooth-anchor controller so it doesn't drift past #indice.
  back_to_index = link_to("↑ Volver al índice", "#indice",
                          class: "small text-decoration-none d-inline-block mb-3",
                          data: { action: "click->smooth-anchor#jump" })
%>

<div class="container my-5" data-controller="smooth-anchor">
  <div class="mb-4">
    <h1 class="h2 mb-2">Acerca de Medici</h1>
    <p class="lead mb-0">
      Manual de operación de la plataforma: cómo avanza un paciente por el reclutamiento, qué
      puede hacer cada tipo de usuario, sobre qué marco normativo colombiano se apoya la
      operación, y qué está construido y qué falta.
    </p>
  </div>

  <%# Clickable index. Native #anchor jumps drift here (the layout adjusts body
      padding from JS after paint), so each link is handled by the smooth-anchor
      Stimulus controller, which scrolls with the navbar height subtracted. %>
  <nav id="indice" class="card health-card shadow-sm mb-5" aria-label="Índice">
    <div class="card-body">
      <h2 class="h6 text-uppercase text-muted mb-3">Índice</h2>
      <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-4">
        <%= link_to t("operation_manual.lifecycle.title"), "#pacientes", class: "text-decoration-none", data: { action: "click->smooth-anchor#jump" } %>
        <%= link_to "Manual de operación por rol", "#manual", class: "text-decoration-none", data: { action: "click->smooth-anchor#jump" } %>
        <%= link_to "Marco normativo colombiano", "#normativa", class: "text-decoration-none", data: { action: "click->smooth-anchor#jump" } %>
        <%= link_to "Estado de la plataforma", "#estado", class: "text-decoration-none", data: { action: "click->smooth-anchor#jump" } %>
      </div>
    </div>
  </nav>

  <%# --------------------------------------------------------------- Pacientes
      First section on purpose: the patient lifecycle is what the platform is
      for, and every role below is described in terms of it.

      Unlike the rest of this page it IS translated — operation_manual.lifecycle.*
      in content_about.*.yml; see OperationManual for why this one section is.
      State and action names come from patients.states.* / patients.<event>, so
      the manual always uses the same word as the badge and the button.

      No patient-state--* badge in the card headers: those are text colours meant
      for a white row, and green measures 1.47:1 on the blue .health-card header.
      The transitions table teaches the colour on white, where it is legible. %>
  <section id="pacientes" class="mb-5">
    <h2 class="h3 mb-1"><%= t("operation_manual.lifecycle.title") %></h2>
    <%= back_to_index %>

    <div class="card health-card shadow-sm mb-4">
      <div class="card-body">
        <p class="mb-2"><%= t("operation_manual.lifecycle.intro") %></p>
        <p class="mb-0 small text-muted"><%= t("operation_manual.lifecycle.intro_note_html") %></p>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <% @patient_states.each_with_index do |state, index| %>
        <div class="col-lg-4">
          <div class="card health-card shadow-sm h-100">
            <div class="card-header">
              <h3 class="h5 mb-0"><%= index + 1 %>. <%= t("patients.states.#{state}") %></h3>
            </div>
            <div class="card-body">
              <p><%= t("operation_manual.lifecycle.states.#{state}.summary") %></p>
              <h4 class="h6 text-uppercase text-muted mt-4"><%= t("operation_manual.lifecycle.arrival_heading") %></h4>
              <p class="mb-0"><%= t("operation_manual.lifecycle.states.#{state}.arrival") %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="card health-card shadow-sm mb-4">
      <div class="card-header">
        <h3 class="h5 mb-0"><%= t("operation_manual.lifecycle.transitions_title") %></h3>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th scope="col"><%= t("operation_manual.lifecycle.table.action") %></th>
                <th scope="col"><%= t("operation_manual.lifecycle.table.change") %></th>
                <th scope="col"><%= t("operation_manual.lifecycle.table.who") %></th>
                <th scope="col"><%= t("operation_manual.lifecycle.table.requires") %></th>
              </tr>
            </thead>
            <tbody>
              <% @patient_transitions.each do |transition| %>
                <tr>
                  <th scope="row" class="fw-semibold text-nowrap">
                    <%= t("patients.#{transition.event}") %>
                    <span class="badge <%= transition.direction == :forward ? "bg-primary-subtle text-primary-emphasis" : "bg-secondary-subtle text-secondary-emphasis" %> border ms-1">
                      <%= t("operation_manual.lifecycle.direction.#{transition.direction}") %>
                    </span>
                  </th>
                  <td class="text-nowrap">
                    <span class="patient-state patient-state--<%= transition.from %>"><%= t("patients.states.#{transition.from}") %></span>
                    <span class="text-muted mx-1" aria-hidden="true">→</span>
                    <span class="visually-hidden"><%= t("operation_manual.lifecycle.moves_to") %></span>
                    <span class="patient-state patient-state--<%= transition.to %>"><%= t("patients.states.#{transition.to}") %></span>
                  </td>
                  <td class="small"><%= t("operation_manual.lifecycle.transitions.#{transition.event}.actor") %></td>
                  <td class="small"><%= t("operation_manual.lifecycle.transitions.#{transition.event}.requirement") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card health-card shadow-sm">
      <div class="card-header">
        <h3 class="h5 mb-0"><%= t("operation_manual.lifecycle.notes_title") %></h3>
      </div>
      <ul class="list-group list-group-flush">
        <% t("operation_manual.lifecycle.notes").each do |note| %>
          <li class="list-group-item"><%= note %></li>
        <% end %>
      </ul>
    </div>
  </section>

  <%# ---------------------------------------------------------------- Manual %>
  <%# The per-role manual moved to its own page on 2026-08-25 (static_pages#manual).
      It was the longest section here by a wide margin and it answers a different
      question — "what does this role do" rather than "what is this platform and
      what is it built on" — so it gets a card that points at it instead of
      sitting inline. %>
  <section id="manual" class="mb-5">
    <h2 class="h3 mb-1">Manual de operación por rol</h2>
    <%= back_to_index %>

    <div class="card health-card shadow-sm">
      <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <p class="mb-1">
            Qué hace cada tipo de usuario, con su recorrido dibujado de principio a fin y la
            tabla de permisos que lo sostiene. Están los <%= @roles_count %> roles de la
            plataforma, incluido el paciente, que no tiene cuenta pero sí recorrido.
          </p>
          <p class="mb-0 small text-muted">
            Vive en su propia página porque se lee solo, no de paso.
          </p>
        </div>
        <%= link_to "Abrir el manual", manual_path, class: "btn btn-primary text-nowrap" %>
      </div>
    </div>
  </section>

  <%# ------------------------------------------------------------- Normativa %>
  <section id="normativa" class="mb-5">
    <h2 class="h3 mb-1">Marco normativo colombiano</h2>
    <%= back_to_index %>
    <p>
      Estas son las normas sobre las que se sustenta la operación en Colombia. Cada una se
      consultó en su fuente oficial y se conserva una copia en el repositorio, porque los
      enlaces de gobierno cambian. Los enlaces de abajo apuntan a la fuente original.
    </p>

    <div class="alert alert-warning" role="alert">
      <strong>Esta página no es asesoría legal.</strong> Resume el análisis hecho sobre las
      normas y distingue de forma deliberada lo confirmado de lo que sigue abierto. Los puntos
      abiertos están señalados como tales tanto aquí como en el estado de la plataforma.
    </div>

    <% @documents.each do |document| %>
      <div class="card health-card shadow-sm mb-3">
        <div class="card-body">
          <h3 class="h6 mb-1">
            <% if document.url.present? %>
              <%= link_to document.title, document.url, target: "_blank", rel: "noopener noreferrer" %>
            <% else %>
              <%= document.title %>
              <span class="badge bg-secondary ms-1">Sin enlace verificado</span>
            <% end %>
          </h3>
          <p class="small text-muted mb-2"><%= document.issuer %></p>
          <p class="mb-0"><%= document.note %></p>
        </div>
      </div>
    <% end %>

    <h3 class="h5 mt-4 mb-3">Documentos internos de análisis</h3>
    <p class="small text-muted">
      Producidos sobre las fuentes anteriores. Viven en el repositorio y no se publican desde
      la plataforma, por lo que se listan por su ubicación.
    </p>
    <ul class="list-group mb-0">
      <% @internal_documents.each do |document| %>
        <li class="list-group-item">
          <code><%= document.title %></code>
          <p class="mb-0 small text-muted"><%= document.note %></p>
        </li>
      <% end %>
    </ul>
  </section>

  <%# ---------------------------------------------------------------- Estado %>
  <section id="estado" class="mb-5">
    <h2 class="h3 mb-1">Estado de la plataforma</h2>
    <%= back_to_index %>
    <p>
      Inventario honesto de lo construido y lo que falta. Lo pendiente se enumera con el mismo
      detalle que lo hecho: varios de los puntos abiertos son obligaciones normativas y no
      mejoras opcionales.
    </p>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="card health-card shadow-sm h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0">Lo que tenemos</h3>
            <span class="badge bg-success"><%= @shipped.size %></span>
          </div>
          <ul class="list-group list-group-flush">
            <% @shipped.each do |feature| %>
              <li class="list-group-item">
                <p class="mb-1 fw-semibold"><%= feature.name %></p>
                <p class="mb-0 small text-muted"><%= feature.detail %></p>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card health-card shadow-sm h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0">Lo que falta</h3>
            <span class="badge bg-secondary"><%= @outstanding.size %></span>
          </div>
          <ul class="list-group list-group-flush">
            <% @outstanding.each do |feature| %>
              <% label, badge_class = status_badge.fetch(feature.status) %>
              <li class="list-group-item">
                <p class="mb-1">
                  <span class="fw-semibold"><%= feature.name %></span>
                  <span class="badge <%= badge_class %> ms-1"><%= label %></span>
                </p>
                <p class="mb-0 small text-muted"><%= feature.detail %></p>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </section>
</div>
