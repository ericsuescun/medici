<div class="container-fluid mt-3">
  <div class="row">
    <% Study.all.each do |study| %>
      <div class="col-3">
        <div class="card mb-3">
          <div class="card-header">
            <%= study.public_title %>
          </div>
          <div class="card-body">
            <h5 class="card-title">Scientific title: <%= study.scientific_title %></h5>
            <p class="card-text">Registry: <%= study.local_unique_register %></p>
            <%= link_to "Quiero participar!", new_user_registration_path(study_id: study.id), class: "btn btn-success btn-block mt-3 mb-3" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
