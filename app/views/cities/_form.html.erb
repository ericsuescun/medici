<%= form_with(model: city) do |form| %>
  <% if city.errors.any? %>
    <div style="color: red">
      <h2><%= t("cities.form_errors", count: city.errors.count) %></h2>

      <ul>
        <% city.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, class: "form-control mb-3" %>
  </div>

  <div>
    <%= form.submit t("common.save"), class: 'btn btn-primary btn-block' %>
  </div>
<% end %>