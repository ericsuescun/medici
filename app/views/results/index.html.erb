<p style="color: green"><%= notice %></p>

<% content_for :title, t("results.index_title") %>

<h1><%= t("results.index_title") %></h1>

<div id="results">
  <% @results.each do |result| %>
    <%= render result %>
    <p>
      <%= link_to t("results.show_this"), result %>
    </p>
  <% end %>
</div>

<%= link_to t("results.new"), new_result_path %>
