<div id="<%= dom_id result %>">
  <p>
    <strong><%= Result.human_attribute_name(:studies_id) %>:</strong>
    <%= result.studies_id %>
  </p>

  <p>
    <strong><%= Result.human_attribute_name(:result_type) %>:</strong>
    <%= t_enum(result, :result_type) %>
  </p>

  <p>
    <strong><%= Result.human_attribute_name(:title) %>:</strong>
    <%= result.title %>
  </p>

  <p>
    <strong><%= Result.human_attribute_name(:description) %>:</strong>
    <%= result.description %>
  </p>

</div>
